---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStops, getWorkshops } from '../lib/content';
import { stepHref, withBase, workshopHref } from '../lib/url';

const workshops = await getWorkshops();
const overview = await Promise.all(workshops.map(async (w) => ({ workshop: w, stops: await getStops(w.id) })));
---

<BaseLayout title="Pro lektory" description="Jak web používat během prezenčního workshopu.">
  <div class="prose">
    <h1>Pro lektory</h1>
    <p class="lead">
      Web je průvodce prezenčním workshopem, ne samostatný kurz. Účastníci postupují podle vašich pokynů.
    </p>

    <h2>Poznámky pro lektora</h2>
    <p>
      Ke každé zastávce jsou připravené poznámky: doporučený čas, cíl, otázka do diskuse a přechod k dalšímu tématu.
      Ve výchozím stavu jsou skryté, aby nerušily účastníky.
    </p>
    <div class="lecturer-toggle">
      <p class="lecturer-toggle__state" data-state role="status">Poznámky pro lektora jsou vypnuté.</p>
      <p>
        <button type="button" class="button" data-toggle aria-pressed="false">Zapnout poznámky pro lektora</button>
      </p>
      <p class="lecturer-toggle__hint">
        Nastavení platí jen pro tento prohlížeč a toto zařízení. Účastníkům se poznámky nezobrazí.
      </p>
      <noscript><p>Poznámky pro lektora vyžadují zapnutý JavaScript.</p></noscript>
    </div>

    <h2>Jak web používat během lekce</h2>
    <ul class="points">
      <li>
        Řekněte například: „Otevřete workshop Digitální stopa a klepněte na zastávku 2.“ Zastávky jsou velké a
        očíslované.
      </li>
      <li>Každá obrazovka má vlastní adresu. Tlačítko Zpět v prohlížeči funguje předvídatelně.</li>
      <li>
        Tlačítko <strong>Pokračovat</strong> je vždy dostupné. Účastníci nemusí aktivitu dokončit, abyste mohli pokračovat.
      </li>
      <li>Po volbě odpovědi se nic neposouvá automaticky. Účastníci mají čas si vysvětlení přečíst.</li>
      <li>
        Web si v zařízení pamatuje jen poslední zastávku. Na přehledu workshopu se pak zobrazí „Pokračovat tam, kde jste
        skončili“. Tlačítko „Začít workshop znovu“ tento údaj smaže, například před dalším kurzem.
      </li>
      <li>
        Při slabé Wi-Fi: otevřete přehled workshopu ještě při připojení. Web si stáhne všechny jeho obrazovky a ty pak
        fungují i při krátkém výpadku.
      </li>
    </ul>

    <h2>Struktura workshopů</h2>
  </div>

  {
    overview.map(({ workshop, stops }) => (
      <section class="structure">
        <h3>
          <a href={workshopHref(workshop.id)}>{workshop.data.title}</a> – {workshop.data.subtitle}
        </h3>
        <ol>
          {stops.map((stop, i) => (
            <li>
              <a href={stepHref(workshop.id, i + 1)}>{stop.data.title}</a>
              {stop.data.lecturer?.time && <span class="structure__time"> ({stop.data.lecturer.time})</span>}
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <div class="prose">
    <h2>Úpravy obsahu</h2>
    <p>
      Texty, otázky a zpětná vazba jsou v souborech YAML ve složce <code>src/content/</code> v repozitáři. Postup je popsaný
      v souboru README.
    </p>
    <p><a href={withBase()}>← Zpět na úvodní stránku</a></p>
  </div>
</BaseLayout>

<script>
  import { lecturerMode } from '../scripts/storage';

  const button = document.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const state = document.querySelector<HTMLElement>('[data-state]')!;

  function render(on: boolean) {
    button.setAttribute('aria-pressed', String(on));
    button.textContent = on ? 'Vypnout poznámky pro lektora' : 'Zapnout poznámky pro lektora';
    state.textContent = on
      ? 'Poznámky pro lektora jsou zapnuté. Uvidíte je u každé zastávky.'
      : 'Poznámky pro lektora jsou vypnuté.';
  }

  render(lecturerMode.isOn());
  button.addEventListener('click', () => lecturerMode.set(!lecturerMode.isOn()));
  document.addEventListener('lecturer-mode', (e) => render((e as CustomEvent<boolean>).detail));
</script>

<style>
  .lecturer-toggle {
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 2px dashed var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
  }

  .lecturer-toggle__state {
    font-weight: 700;
  }

  .lecturer-toggle__hint {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .structure ol {
    padding-left: 1.5em;
  }

  .structure__time {
    color: var(--color-text-muted);
  }

  code {
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
    background: var(--color-surface-alt);
    font-size: 0.9em;
  }
</style>
