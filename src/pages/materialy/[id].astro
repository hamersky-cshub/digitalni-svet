---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { isWorkshopUnlocked } from '../../lib/access';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActionButton from '../../components/ActionButton.astro';
import { TYPE_ICONS, TYPE_LABELS, formatDate, resourceAction } from '../../lib/resources';
import Icon from '../../components/Icon.astro';
import { workshopHref } from '../../lib/url';

export const getStaticPaths = (async () => {
  const resources = await getCollection('resources', resource => isWorkshopUnlocked(resource.data.workshop.id));
  return resources.map((resource) => ({ params: { id: resource.id }, props: { resource } }));
}) satisfies GetStaticPaths;

const { resource } = Astro.props;
const { title, description, type, source, updated } = resource.data;
const workshop = await getEntry(resource.data.workshop);
const { Content } = await render(resource);
const action = resourceAction(resource);
const backHref = workshopHref(workshop.id);
---

<BaseLayout title={title} description={description}>
  <p class="back"><a href={backHref}><span aria-hidden="true">←</span> Zpět na workshop {workshop.data.title}</a></p>

  <article>
    <p class="meta">
      <span class="badge"><Icon name={TYPE_ICONS[type]} /> {TYPE_LABELS[type]}</span>
    </p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>

    <dl class="details">
      <div>
        <dt>Workshop</dt>
        <dd><a href={backHref}>{workshop.data.title}</a></dd>
      </div>
      {
        source && (
          <div>
            <dt>Zdroj</dt>
            <dd>{source}</dd>
          </div>
        )
      }
      {
        updated && (
          <div>
            <dt>Aktualizováno</dt>
            <dd>
              <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time>
            </dd>
          </div>
        )
      }
    </dl>

    {
      type !== 'navod' && (
        <p class="action">
          <ActionButton action={action} />
        </p>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="back">
    <a href={backHref}><span aria-hidden="true">←</span> Zpět na workshop {workshop.data.title}</a>
  </p>
</BaseLayout>

<style>
  .meta {
    margin: var(--space-3) 0 0;
  }

  .meta + h1 {
    margin-top: var(--space-1);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    border: 2px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0 0 var(--space-3);
  }

  .details dt {
    font-weight: 700;
  }

  .details dd {
    margin: 0;
  }

  .action {
    margin: var(--space-3) 0 var(--space-4);
  }

  .back {
    margin-top: var(--space-3);
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }
</style>
