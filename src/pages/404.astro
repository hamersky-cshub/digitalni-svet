---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Stránka nenalezena" noindex>
  <div class="prose page-intro">
    <h1>Stránka nenalezena</h1>
    <p class="lead">Tato adresa neexistuje, nebo téma zatím není otevřené.</p>
    <p>
      <a class="button button--large" href={withBase()}>Zpět na témata</a>
    </p>
  </div>
</BaseLayout>
