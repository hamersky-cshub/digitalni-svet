---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Stránka nenalezena">
  <div class="prose page-intro">
    <h1>Toto téma zatím není dostupné</h1>
    <p class="lead">Vraťte se k přehledu témat a otevřete dostupný workshop.</p>
    <p>
      <a class="button button--large" href={withBase()}>Zpět na témata</a>
    </p>
  </div>
</BaseLayout>
