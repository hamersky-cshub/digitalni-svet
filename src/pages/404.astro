---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Stránka nenalezena">
  <div class="prose">
    <h1>Tuto stránku jsme nenašli</h1>
    <p class="lead">Nic se neděje. Stránka na této adrese neexistuje, možná byla přesunuta.</p>
    <p>
      <a class="button button--large" href={withBase()}>Přejít na úvodní stránku</a>
    </p>
  </div>
</BaseLayout>
