---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActivityBlock from '../../../components/activities/ActivityBlock.astro';
import Avatar from '../../../components/Avatar.astro';
import HomeMaterials from '../../../components/HomeMaterials.astro';
import Progress from '../../../components/Progress.astro';
import ScreenFigures from '../../../components/ScreenFigures.astro';
import ScreenKind from '../../../components/ScreenKind.astro';
import StepNav from '../../../components/StepNav.astro';
import { buildSteps, getGlossary, getStops, getAvailableWorkshops } from '../../../lib/content';
import { withBase } from '../../../lib/url';
import { formatText, plainText, startsWithEmoji, termIds } from '../../../lib/text';

export const getStaticPaths = (async () => {
  const workshops = await getAvailableWorkshops();
  const paths = [];
  for (const workshop of workshops) {
    const steps = buildSteps(workshop, await getStops(workshop.id));
    for (const step of steps) {
      paths.push({
        params: {
          workshop: workshop.id,
          stop: `zastavka-${step.stopNumber}`,
          step: step.stepNumber === 1 ? undefined : `krok-${step.stepNumber}`,
        },
        props: { step },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { step } = Astro.props;
const { workshop, stop, screen, stopNumber, stopCount, stepNumber, stepCount, prev, next } = step;

// Vysvětlení pojmů ze slovníčku, které obrazovka používá (src/scripts/terms.ts je rozbalí v textu).
const used = termIds(JSON.stringify(screen));
const glossary = used.length ? await getGlossary() : [];
const terms = Object.fromEntries(
  glossary.filter((e) => used.includes(e.id)).map((e) => [e.id, { term: e.data.term, definition: formatText(e.data.definition) }]),
);
const termsJson = JSON.stringify(terms).replace(/</g, '\\u003c');
---

<BaseLayout
  title={`Zastávka ${stopNumber}${stepCount > 1 ? `, krok ${stepNumber}` : ''}: ${plainText(screen.title)} – ${workshop.data.title}`}
  description={stop.data.summary}
  workshop={workshop.id}
  stop={stopNumber}
  step={stepNumber}
>
  <Progress
    workshopId={workshop.id}
    workshopTitle={workshop.data.title}
    stopTitle={stop.data.title}
    stopNumber={stopNumber}
    stopCount={stopCount}
    stepNumber={stepNumber}
    stepCount={stepCount}
  />

  <article class="screen">
    <div class="screen-heading"><ScreenKind kind={screen.kind} />{screen.kind === 'prakticky' && <a class="all-tasks" href={withBase('prakticke-ukoly/')}>Všechny praktické úkoly <span aria-hidden="true">→</span></a>}</div>
    <h1 set:html={formatText(screen.title)} />
    {
      screen.text.length > 0 &&
        (screen.persona ? (
          <div class="screen__persona">
            <Avatar name={screen.persona} />
            <div class="prose screen__text">
              {screen.text.map((p) => (
                <p set:html={formatText(p)} />
              ))}
            </div>
          </div>
        ) : (
          <div class="prose screen__text">
            {screen.text.map((p) => (
              <p set:html={formatText(p)} />
            ))}
          </div>
        ))
    }
    {
      screen.points && (
        <ul class="points screen__points">
          {screen.points.map((point) => (
            <li class:list={[{ 'points__item--icon': startsWithEmoji(point) }]} set:html={formatText(point)} />
          ))}
        </ul>
      )
    }
    {screen.figures && <ScreenFigures figures={screen.figures} />}
    {screen.activity && <ActivityBlock activity={screen.activity} nextLabel={next.label} />}
    {
      next.label === 'Dokončit workshop' && (
        <section class="screen__home" aria-labelledby="na-doma">
          <h2 id="na-doma">Na doma</h2>
          <HomeMaterials workshops={[{ id: workshop.id, title: workshop.data.title }]} />
        </section>
      )
    }
  </article>


  <StepNav prev={prev} next={next} workshopId={workshop.id} />
  {used.length > 0 && <script type="application/json" id="terms-data" set:html={termsJson} />}
</BaseLayout>

<script>
  import '../../../scripts/terms';
</script>

<style>
  .screen-heading { display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.5rem; }
  .all-tasks { display:inline-flex;align-items:center;min-height:2.75rem;font-size:.85rem; }
  .screen h1 {
    margin-top: var(--space-2);
  }

  .screen__text {
    font-size: 1.1rem;
  }

  /* Text o postavě: avatar vlevo od textu. */
  .screen__persona {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .screen__persona .screen__text :last-child {
    margin-bottom: 0;
  }

  .screen__points {
    font-size: 1.1rem;
  }

  .screen__home {
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 2px solid var(--color-border-light);
  }

  .screen__home h2 {
    margin: 0;
    font-size: 1.3rem;
  }
</style>
