---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import ModuleIcon from '../../components/ModuleIcon.astro';
import { moduleStyles, defaultModuleStyle } from '../../lib/presentation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { buildSteps, getStops, getAvailableWorkshops } from '../../lib/content';
import { formatText, plural } from '../../lib/text';
import { stepHref, withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const workshops = await getAvailableWorkshops();
  return workshops.map((workshop) => ({ params: { workshop: workshop.id }, props: { workshop } }));
}) satisfies GetStaticPaths;

const { workshop } = Astro.props;
const stops = await getStops(workshop.id);
const steps = buildSteps(workshop, stops);
const tasks = steps.filter(step => step.screen.kind === 'prakticky');
const theme = moduleStyles[workshop.id] ?? defaultModuleStyle;
const resources = (await getCollection('resources', (r) => r.data.workshop.id === workshop.id)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'cs'),
);
const [firstParagraph, ...moreParagraphs] = workshop.data.annotation;
// Seznam všech obrazovek pro offline režim (service worker si je stáhne předem).
const offlineUrls = [Astro.url.pathname, ...steps.map((s) => s.href)];
---

<BaseLayout title={workshop.data.title} description={workshop.data.cardText} moduleId={workshop.id}>
  <p class="back-link"><a href={withBase()}>← Úvodní stránka</a></p>

  <header class="workshop-header">
    <p class="eyebrow">Modul 0{workshop.data.order} · {theme.topic}</p>
    <img class="workshop-art" src={withBase(`images/modules/${workshop.id}.webp`)} alt="" width="800" height="800" />
    <h1>{workshop.data.title}</h1>
    <p class="workshop-header__subtitle">{workshop.data.subtitle}</p>
    <p class="lead">{workshop.data.cardText}</p>
    <div class="workshop-meta"><span class="pill">{stops.length} zastávek</span><span class="pill">{tasks.length} {plural(tasks.length, ['praktický úkol', 'praktické úkoly', 'praktických úkolů'])}</span><span>{workshop.data.duration}</span></div>
    <div class="workshop-actions"><a class="button" href={steps[0].href}>Začít od první zastávky <ModuleIcon name="arrow" size={22} /></a><a class="button button--secondary" href="#prakticke-ukoly">Přejít na praktické úkoly</a></div>
    <details class="disclosure"><summary>Co se v tomto modulu naučíte</summary><div class="disclosure__body"><p set:html={formatText(firstParagraph)} />{moreParagraphs.map(p => <p set:html={formatText(p)} />)}</div></details>
  </header>

  <section aria-labelledby="zastavky">
    <h2 id="zastavky">Krok za krokem modulem</h2>

    <ol class="route" data-progress={workshop.id}>
      {
        stops.map((stop, i) => (
          <li class="route__stop" data-stop-card={i + 1}>
            <span class="route__number" aria-hidden="true">
              {i + 1}
            </span>
            <div class="route__body">
              <h3 class="route__title">
                <a href={stepHref(workshop.id, i + 1)}>
                  <span class="visually-hidden">Zastávka {i + 1}: </span>
                  {stop.data.title}
                </a>
              </h3>
              <p class="route__summary">{stop.data.summary}</p>
              <p class="route__meta">
                {stop.data.screens.some(screen => screen.kind === 'prakticky') && <span class="pill">Praktický úkol</span>}
                {stop.data.screens.length} {plural(stop.data.screens.length, ['krok', 'kroky', 'kroků'])}
                <span class="route__visited" data-visited hidden>
                  <span aria-hidden="true">✓</span> Navštíveno
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="module-practice" aria-labelledby="prakticke-ukoly">
    <p class="eyebrow">Vyzkoušejte si to sami</p><h2 id="prakticke-ukoly">Praktické úkoly v tomto modulu</h2>
    <p>Úkol můžete otevřít přímo. Pokud si nejste jistí, požádejte o pomoc lektora.</p>
    <ul class="task-links">{tasks.map(task => <li><a href={task.href}><span><span class="task-location">Zastávka {task.stopNumber} · krok {task.stepNumber}</span><strong>{task.screen.title}</strong></span><ModuleIcon name="arrow" size={24} /></a></li>)}</ul>
  </section>

  {
    resources.length > 0 && (
      <section aria-labelledby="materialy">
        <h2 id="materialy">Materiály ke stažení</h2>
        <p>Návody a materiály, ke kterým se můžete vrátit i po workshopu.</p>
        <ul class="resource-list">
          {resources.map((resource) => (
            <ResourceCard resource={resource} />
          ))}
        </ul>
      </section>
    )
  }

  <section class="restart" data-restart-box hidden aria-labelledby="znovu">
    <h2 id="znovu">Projít téma znovu</h2>

    <p>
      <button type="button" class="button button--secondary" data-restart={workshop.id}>Začít od první zastávky</button>
    </p>
    <p class="restart__done" data-restart-done role="status"></p>
  </section>

  <script type="application/json" id="offline-urls" set:html={JSON.stringify(offlineUrls)} />
</BaseLayout>

<script>
  import { progress } from '../../scripts/storage';

  // U zastávek, kterými už účastník prošel, se zobrazí „Navštíveno“ (uloženo jen v tomto prohlížeči).
  const workshop = document.querySelector<HTMLElement>('[data-progress]')?.dataset.progress;

  function render() {
    if (!workshop) return;
    const visited = progress.getVisited(workshop);
    document.querySelectorAll<HTMLElement>('[data-stop-card]').forEach((card) => {
      const done = visited.includes(Number(card.dataset.stopCard));
      card.classList.toggle('is-visited', done);
      card.querySelector<HTMLElement>('[data-visited]')!.hidden = !done;
    });
  }

  if (workshop) {
    document.querySelector<HTMLElement>('[data-restart-box]')!.hidden = false;
    document.querySelector('[data-restart]')!.addEventListener('click', () => {
      progress.reset(workshop);
      render();
      document.querySelector('[data-restart-done]')!.textContent = 'Hotovo. Workshop můžete začít od první zastávky.';
    });
    render();
  }

  // Offline režim: požádá service worker, aby si stáhl všechny obrazovky workshopu.
  const urls = JSON.parse(document.getElementById('offline-urls')?.textContent ?? '[]');
  if ('serviceWorker' in navigator && urls.length) {
    navigator.serviceWorker.ready
      .then((registration) => registration.active?.postMessage({ type: 'precache', urls }))
      .catch(() => {});
  }
</script>

<style>
  .back-link {
    margin: var(--space-2) 0 0;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }

  .workshop-header { padding:1.5rem 0 2rem; }
  .workshop-header h1 { font-weight:700;letter-spacing:-.04em;text-decoration:underline;text-decoration-color:var(--module-color);text-decoration-thickness:4px;text-underline-offset:.2em;margin-bottom:1rem; }
  .workshop-art { float:right;width:10rem;height:10rem;object-fit:contain;margin:0 0 1.5rem 1.5rem; }
  .workshop-header .disclosure { clear:both; }
  @media(max-width:650px){ .workshop-art{display:none} }
  .workshop-icon { display:inline-grid;place-items:center;padding:1rem;border-radius:.65rem;background:var(--module-soft);color:var(--module-color);margin-bottom:.5rem; }
  .workshop-meta { display:flex;flex-wrap:wrap;align-items:center;gap:.75rem;margin-bottom:1.5rem;color:var(--color-text-muted);font-size:.9rem; }
  .workshop-actions { display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1.5rem; }
  .module-practice { padding:2rem 0; }
  .module-practice h2 { margin-top:0; }
  .task-links { max-width:none;list-style:none;padding:0;border:1px solid var(--color-border-light);border-radius:var(--radius);overflow:hidden; }
  .task-links li { margin:0; }
  .task-links li+li { border-top:1px solid var(--color-border-light); }
  .task-links a { display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.1rem 1.25rem;min-height:3.5rem;text-decoration:none;color:var(--color-text); }
  .task-links a:hover { background:var(--module-soft);text-decoration:underline; }
  .task-links svg { color:var(--module-color);flex:none; }
  .task-location { display:block;font-size:.85rem;color:var(--module-color);margin-bottom:.2rem; }
  .workshop-header__icon {
    margin: var(--space-1) 0 0;
    font-size: 3rem;
    line-height: 1;
  }

  .workshop-header h1 {
    margin-top: var(--space-1);
    margin-bottom: 0;
  }

  .workshop-header__subtitle {
    margin-bottom: var(--space-2);
    color: var(--module-color);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .route {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .route__stop {
    position: relative;
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding-bottom: var(--space-3);
  }

  /* Cesta mezi zastávkami */
  .route__stop:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(2rem - 2px);
    top: 4rem;
    bottom: 0;
    width: 4px;
    background: var(--color-border-light);
  }

  .route__number {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 4rem;
    height: 4rem;
    border: 2px solid var(--module-color);
    border-radius: .6rem;
    background: var(--module-soft);
    color: var(--module-color);
    font-size: 1.6rem;
    font-weight: 800;
  }

  .route__stop.is-visited .route__number {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .route__body {
    position: relative;
    flex: 1;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .route__body:hover {
    border-color: var(--color-primary);
  }

  .route__title {
    margin: 0;
    font-size: 1.35rem;
  }

  .route__title a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-size);
  }

  /* Celá karta zastávky je klikací (i číslo vlevo). */
  .route__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    left: calc(-4rem - var(--space-2) - 3px);
  }

  .route__summary {
    margin-bottom: 0.25rem;
  }

  .route__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .route__visited {
    color: var(--color-ok);
    font-weight: 700;
  }

  .route__body :global(.lecturer-note) {
    position: relative;
    z-index: 1;
  }

  .restart {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 2px solid var(--color-border-light);
  }

  .restart h2 {
    margin-top: var(--space-2);
    font-size: 1.2rem;
  }

  .restart__done {
    font-weight: 700;
    color: var(--color-ok);
  }

  @media (max-width: 40rem) {
    .route__number {
      width: 3rem;
      height: 3rem;
      font-size: 1.3rem;
    }

    .route__stop:not(:last-child)::before {
      left: calc(1.5rem - 2px);
      top: 3rem;
    }

    .route__title a::after {
      left: calc(-3rem - var(--space-2) - 3px);
    }

    .route__body {
      padding: var(--space-2);
    }
  }
</style>
