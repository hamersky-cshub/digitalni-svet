---
import '../styles/global.css';
import CompassIcon from '../components/CompassIcon.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Údaje pro zapamatování pozice ve workshopu (jen v prohlížeči). */
  workshop?: string;
  stop?: number;
  stepLabel?: string;
}

const {
  title,
  description = 'Tři praktická setkání o bezpečnějším používání digitálního světa.',
  workshop,
  stop,
  stepLabel,
} = Astro.props;
const siteName = 'Digitální svět pod kontrolou';
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#062f47" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="cs_CZ" />
  </head>
  <body data-workshop={workshop} data-stop={stop} data-step-label={stepLabel}>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>

    <aside class="lecturer-bar" data-lecturer hidden aria-label="Režim lektora">
      <div class="container lecturer-bar__inner">
        <span><strong>Režim lektora je zapnutý.</strong> Účastníci poznámky nevidí.</span>
        <button type="button" class="lecturer-bar__off" data-lecturer-off>Vypnout</button>
      </div>
    </aside>

    <header class="site-header">
      <div class="container">
        <a class="site-logo" href={withBase()}>
          <CompassIcon size={44} />
          <span>{siteName}</span>
        </a>
      </div>
    </header>

    <main id="obsah" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          <strong>{siteName}</strong> – průvodce workshopy o bezpečnějším používání internetu.
        </p>
        <p class="site-footer__privacy">
          Tento web nesbírá žádné osobní údaje a vaše odpovědi nikam neodesílá.
        </p>
        <ul class="site-footer__links">
          <li><a href={withBase()}>Úvodní stránka</a></li>
          <li><a href={withBase('o-projektu/')}>O projektu a soukromí</a></li>
          <li><a href={withBase('pro-lektory/')}>Pro lektory</a></li>
        </ul>
      </div>
    </footer>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: -10rem;
    z-index: 10;
    padding: var(--space-1) var(--space-2);
    background: var(--color-focus);
    color: var(--color-focus-text);
    font-weight: 700;
  }

  .skip-link:focus {
    top: var(--space-1);
  }

  main:focus {
    outline: none;
  }

  main {
    padding-bottom: var(--space-4);
  }

  .lecturer-bar {
    background: var(--color-accent-soft);
    border-bottom: 3px solid var(--color-accent);
    font-size: 0.9rem;
  }

  .lecturer-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
  }

  .lecturer-bar__off {
    min-height: 2.75rem;
    padding: 0.3rem 1rem;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-primary);
    font-weight: 700;
  }

  .site-header {
    background: var(--color-primary-dark);
    color: var(--color-on-primary);
    border-bottom: 5px solid var(--color-accent);
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.5rem;
    color: var(--color-on-primary);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .site-logo:hover {
    color: var(--color-on-primary);
    text-decoration: underline;
  }

  .site-footer {
    padding: var(--space-4) 0;
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border-light);
    font-size: 0.95rem;
  }

  .site-footer__privacy {
    color: var(--color-text-muted);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .site-footer__links li {
    margin: 0;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
</style>
