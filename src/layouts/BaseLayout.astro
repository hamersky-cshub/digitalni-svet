---
import '../styles/global.css';
import CompassIcon from '../components/CompassIcon.astro';
import { getWorkshops } from '../lib/content';
import { isWorkshopUnlocked } from '../lib/access';
import { withBase } from '../lib/url';
import { moduleStyles } from '../lib/presentation';
interface Props { title: string; description?: string; workshop?: string; stop?: number; step?: number; wide?: boolean; moduleId?: string; /** Stránka se nemá objevit ve vyhledávačích (offline, 404, pro lektory). */ noindex?: boolean; }
const { title, description = 'Tři praktické moduly pro bezpečnější internet. Srozumitelně, v klidu a vlastním tempem. Pro dospělé 60+.', workshop, stop, step, wide = false, moduleId, noindex = false } = Astro.props;
const siteName = 'Digitální svět pod kontrolou';
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const theme = moduleStyles[moduleId ?? workshop ?? ''];
const workshops = await getWorkshops();
// Písma uložená na webu. Rubik (nadpisy) je zmenšený jen na latinku – zdroj a postup jsou v README.
const FONTS = [
  { family: 'Atkinson Hyperlegible Next', weight: 400, file: 'AtkinsonHyperlegibleNext-Regular', preload: true },
  { family: 'Atkinson Hyperlegible Next', weight: 700, file: 'AtkinsonHyperlegibleNext-Bold', preload: false },
  { family: 'Rubik', weight: 700, file: 'Rubik-Bold-latin', preload: true },
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-title" content="Digitální svět" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:locale" content="cs_CZ" />
    {FONTS.filter((font) => font.preload).map((font) => <link rel="preload" href={withBase(`fonts/${font.file}.woff2`)} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={FONTS.map(({ family, weight, file }) => `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};src:url('${withBase(`fonts/${file}.woff2`)}') format('woff2');font-display:swap;}`).join('')} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (localStorage.getItem('dspk:large-text') === 'true') document.documentElement.dataset.largeText = ''; } catch {}
    </script>
  </head>
  <body data-workshop={workshop} data-stop={stop} data-step={step} style={theme && `--module-color:${theme.color};--module-text:${theme.text};--module-soft:${theme.soft}`}>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="site-logo" href={withBase()} aria-label={`${siteName} – úvodní stránka`}><span class="logo-mark"><CompassIcon size={38} /></span><span>Digitální svět<small>pod kontrolou</small></span></a>
        <button type="button" class="text-size" data-text-size aria-pressed="false"><span aria-hidden="true">A<span class="bigger-a">A</span></span><span data-text-size-label>Větší písmo</span></button>
      </div>
    </header>
    <main id="obsah" tabindex="-1"><div class:list={['container', { 'reading-container': !wide }]}><slot /></div></main>
    <footer class="site-footer"><div class="container footer-topics"><a class="footer-brand" href={withBase()}>Digitální svět{' '}<span>pod kontrolou.</span></a><nav aria-label="Témata workshopů"><ul>{workshops.map(topic => <li>{isWorkshopUnlocked(topic.id) ? <a href={withBase(`${topic.id}/`)}>{topic.data.title}</a> : <span class="footer-locked">{topic.data.title}<small>Dostupné později</small></span>}</li>)}</ul></nav></div></footer>
    <script>import '../scripts/site';</script>
  </body>
</html>
<style>
.skip-link{position:absolute;left:1rem;top:-10rem;z-index:20;padding:.5rem 1rem;background:var(--color-focus);color:#111;font-weight:700}.skip-link:focus{top:1rem}main:focus{outline:none}main{padding-bottom:3rem}.reading-container{max-width:52rem}.site-header{background:white}.header-inner{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding-block:1.5rem}.site-logo{display:flex;align-items:center;gap:.6rem;color:var(--color-text);font-family:var(--font-heading);font-size:1.05rem;font-weight:500;line-height:1.25;text-decoration:none;flex:none}@media(hover:hover){.site-logo:hover{color:var(--color-primary)}}.site-logo small{display:block;font-size:.8rem;font-weight:400;color:var(--color-text-muted)}.logo-mark{display:grid;place-items:center;width:2.7rem;height:2.7rem;background:#eaf0ff;color:#2563eb;border-radius:.6rem}.text-size{display:none;align-items:center;gap:.5rem;min-height:2.8rem;background:white;color:var(--color-primary);border:2px solid var(--color-primary);border-radius:.4rem;padding:.3rem .65rem;font-size:.85rem;white-space:nowrap}:global(html.js) .text-size{display:flex}.bigger-a{font-size:1.1rem}:global(html[data-large-text]) .text-size{background:var(--color-primary);color:#fff}.site-footer{background:#f3f6fc;border-top:1px solid #e2e8f2;padding-top:3rem;font-size:.9rem}.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:2rem;padding-bottom:2rem}.footer-brand{font-family:var(--font-heading);font-weight:700;font-size:1.2rem;color:var(--color-text);text-decoration:none;display:block;margin-bottom:.9rem}.footer-brand span{color:var(--color-primary)}.footer-grid p{line-height:1.6}.footer-privacy{color:var(--color-text-muted);font-size:.85rem}.footer-links{margin:0;padding:0;list-style:none}.footer-links li{margin:0}.footer-links a{display:inline-flex;align-items:center;min-height:2.8rem;color:var(--color-text-muted)}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid #dbe3ee;padding-block:1.5rem;font-size:.8rem;color:var(--color-text-muted)}
@media(max-width:1100px){.header-inner{flex-wrap:wrap;gap:.6rem 1rem}.text-size{margin-left:auto}}@media(max-width:600px){.site-logo{font-size:.95rem}.text-size{font-size:.8rem}.footer-grid{grid-template-columns:1fr;gap:1rem}.footer-bottom{flex-direction:column;gap:.3rem}}
</style>

<style>
.footer-topics{display:flex;justify-content:space-between;align-items:flex-start;gap:2rem;padding-bottom:2rem}.footer-topics ul{display:flex;flex-wrap:wrap;gap:1.5rem;list-style:none;margin:0;padding:0;max-width:none}.footer-topics li{margin:0}.footer-topics li a{min-height:2.8rem;display:inline-flex;align-items:center}.footer-locked{display:block;color:#47556b;line-height:1.4;padding-top:.4rem}.footer-locked small{display:block;font-size:.75rem;margin-top:.25rem}.logo-mark{background:transparent;padding:0}.site-logo{font-weight:700}.site-logo small{font-family:var(--font-body);font-weight:400}.site-footer{background:#f1f5fa}
@media(max-width:850px){.footer-topics{flex-direction:column;gap:.5rem}}@media(max-width:600px){.footer-topics ul{flex-direction:column;gap:.7rem}}
</style>
