---
/** Vybere komponentu podle typu aktivity (pole "type" v obsahu). */
import type { Activity } from '../../content.config';
import ChoiceSequence, { type SequenceItem } from './ChoiceSequence.astro';
import DeviceSelector from './DeviceSelector.astro';
import HotspotImage from './HotspotImage.astro';
import KeyReuse from './KeyReuse.astro';
import LoginSimulation from './LoginSimulation.astro';
import MessageSignals from './MessageSignals.astro';
import PassphraseBuilder from './PassphraseBuilder.astro';
import Reflection from './Reflection.astro';
import Rules from './Rules.astro';

interface Props {
  activity: Activity;
  nextLabel: string;
}

const { activity, nextLabel } = Astro.props;

let sequence: SequenceItem[] | undefined;
if (activity.type === 'choices') {
  sequence = activity.items.map((item) => ({
    text: item.text,
    message: item.message,
    question: activity.question,
    explanation: item.explanation,
    options: activity.options.map((o) => {
      const response = item.responses?.[o.id];
      const recommended = item.recommended?.includes(o.id);
      return { id: o.id, label: o.label, tone: response?.tone ?? (recommended ? 'ok' : 'info'), response: response?.text };
    }),
  }));
} else if (activity.type === 'scenarios') {
  sequence = activity.items.map((item) => ({
    text: item.text,
    message: item.message,
    question: item.question,
    explanation: item.lesson,
    options: item.options.map((o, i) => ({ id: `moznost-${i + 1}`, label: o.label, tone: o.tone, response: o.feedback })),
  }));
}
---

{sequence && (activity.type === 'choices' || activity.type === 'scenarios') && <ChoiceSequence items={sequence} itemLabel={activity.itemLabel} nextLabel={nextLabel} />}
{activity.type === 'hotspots' && <HotspotImage {...activity} />}
{activity.type === 'signals' && <MessageSignals {...activity} />}
{activity.type === 'device' && <DeviceSelector {...activity} />}
{activity.type === 'reflection' && <Reflection {...activity} />}
{activity.type === 'passphrase' && <PassphraseBuilder {...activity} />}
{activity.type === 'keyReuse' && <KeyReuse {...activity} />}
{activity.type === 'login' && <LoginSimulation {...activity} />}
{activity.type === 'rules' && <Rules {...activity} />}
