---
/**
 * HotspotImage – ilustrace s místy, na která lze klepnout.
 * Každé místo je skutečné tlačítko (funguje dotykem i klávesnicí).
 * Bez JavaScriptu se pod obrázkem zobrazí seznam všech míst s vysvětlením.
 */
import type { SCENES } from '../../content.config';
import { formatText } from '../../lib/text';
import { stableId } from '../../lib/id';
import HolidayScene from '../illustrations/HolidayScene.astro';

interface Props {
  scene: (typeof SCENES)[number];
  instruction: string;
  alt: string;
  spots: { x: number; y: number; label: string; text: string }[];
}

const { instruction, alt, spots } = Astro.props;
const uid = stableId('hs', spots);
---

<spot-explorer class="hotspots" data-total={spots.length} data-noun="místa">
  <p class="hotspots__instruction"><strong>{instruction}</strong></p>
  <image-zoom data-label={alt}>
  <figure class="hotspots__figure">
    <div class="hotspots__image">
      <div class="hotspots__frame"><HolidayScene /></div>
      {
        spots.map((spot, i) => (
          <button
            type="button"
            class="hotspot"
            style={`left: ${spot.x}%; top: ${spot.y}%`}
            data-spot={`${uid}-${i}`}
            aria-pressed="false"
            aria-label={`Místo ${i + 1}`}
          >
            <span aria-hidden="true">{i + 1}</span>
          </button>
        ))
      }
    </div>
    <figcaption class="visually-hidden">{alt}</figcaption>
  </figure>
  <p class="zoom-row"><button type="button" class="button button--secondary" data-zoom-open hidden>Zvětšit obrázek</button></p>
  </image-zoom>

  <p class="spot-status" data-status role="status" hidden><span class="visually-hidden" data-status-detail></span><span data-status-count></span></p>

  <ol class="spot-list" data-list>
    {
      spots.map((spot, i) => (
        <li class="spot-explain" data-explain={`${uid}-${i}`} value={i + 1}>
          <p class="spot-explain__title">{spot.label}</p>
          <p set:html={formatText(spot.text)} />
        </li>
      ))
    }
  </ol>
  <p data-controls hidden>
    <button type="button" class="button button--secondary" data-show-all>Ukázat všechna místa</button>
  </p>
</spot-explorer>

<script>
  import './spot-explorer';
  import '../../scripts/zoom';
</script>

<style>
  .hotspots {
    display: block;
    margin: var(--space-3) 0;
  }

  .hotspots__figure {
    margin: 0 0 var(--space-2);
  }

  /* Rám ořezává jen obrázek; klepací místa u okraje se neořežou. */
  .hotspots__image {
    position: relative;
    container-type: inline-size;
    line-height: 0;
  }

  .hotspots__frame {
    overflow: hidden;
    border: 3px solid var(--color-border);
    border-radius: var(--radius);
  }

  .hotspots__image :global(.scene) {
    display: block;
    width: 100%;
  }

  .hotspot {
    position: absolute;
    display: grid;
    place-items: center;
    /* Velikost podle šířky obrázku (aspoň 44 px), neroste s větším písmem. */
    width: 3rem;
    height: 3rem;
    width: clamp(44px, 10cqi, 60px);
    height: clamp(44px, 10cqi, 60px);
    transform: translate(-50%, -50%);
    border: 4px solid var(--color-primary-dark);
    border-radius: 50%;
    background: var(--color-focus);
    color: var(--color-focus-text);
    font-size: 1.1rem;
    font-size: clamp(16px, 3.6cqi, 22px);
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0 0 3px #ffffff;
  }

  .hotspot[aria-pressed='true'] {
    background: var(--color-primary-dark);
    color: #ffffff;
    box-shadow: 0 0 0 4px var(--color-focus);
  }
</style>
