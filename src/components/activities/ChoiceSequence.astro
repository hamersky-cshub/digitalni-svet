---
/**
 * Scenario / ChoiceCard / Feedback – řada situací, u každé několik velkých tlačítek.
 * Po volbě zůstane otázka viditelná, vybraná možnost se označí, zobrazí se vysvětlení
 * a tlačítko „Další …“. Nic se neposouvá automaticky a nic se neukládá.
 * Bez JavaScriptu se zobrazí všechny situace a vysvětlení v rozbalovacích částech.
 */
import type { MEDIA, TONES } from '../../content.config';
import type { PersonaName } from '../../lib/personas';
import Avatar from '../Avatar.astro';
import { formatText, zOrZe } from '../../lib/text';
import { stableId } from '../../lib/id';
import ToneLabel from '../ToneLabel.astro';
import MessageMock from './MessageMock.astro';

export interface SequenceItem {
  text?: string;
  message?: { medium: (typeof MEDIA)[number]; sender: string; subject?: string; time?: string; lines: string[] };
  persona?: PersonaName;
  question: string;
  options: { id: string; label: string; tone: (typeof TONES)[number]; response?: string }[];
  explanation?: string;
}

interface Props {
  items: SequenceItem[];
  itemLabel: string;
  /** Text tlačítka v dolní navigaci (pro větu „Pokračujte tlačítkem …“). */
  nextLabel: string;
}

const { items, itemLabel, nextLabel } = Astro.props;
const count = items.length;
const labelLower = itemLabel.toLocaleLowerCase('cs');
/** 2. pád množného čísla pro shrnutí „Prošli jste 12 ze 14 zpráv“. */
const GENITIVE_PLURAL: Record<string, string> = {
  situace: 'situací',
  zpráva: 'zpráv',
  adresa: 'adres',
  heslo: 'hesel',
  informace: 'informací',
  položka: 'položek',
  porovnání: 'porovnání',
  'část hovoru': 'částí hovoru',
};
const summaryNoun = GENITIVE_PLURAL[labelLower] ?? 'položek';
const uid = stableId('seq', items);
// Dvě krátké možnosti vedle sebe, jinak velká tlačítka pod sebou (přehlednější).
const rowLayout = (item: SequenceItem) => item.options.length === 2 && item.options.every((o) => o.label.length <= 24);
import Icon from '../Icon.astro';
---

<choice-sequence class="sequence">
  {
    items.map((item, i) => (
      <section class="sequence__item" data-item={i} aria-labelledby={`${uid}-${i}-q`}>
        {count > 1 && (
          <p class="sequence__counter" tabindex="-1" data-counter>
            {itemLabel} {i + 1} {zOrZe(count)} {count}
          </p>
        )}
        {item.text &&
          (item.persona ? (
            <div class="sequence__persona">
              <Avatar name={item.persona} />
              <p class="sequence__text" set:html={formatText(item.text)} />
            </div>
          ) : (
            <p class="sequence__text" set:html={formatText(item.text)} />
          ))}
        {item.message && <MessageMock {...item.message} />}
        <p class="sequence__question" id={`${uid}-${i}-q`}>
          {item.question}
        </p>

        <ul class:list={['choice-list', { 'choice-list--row': rowLayout(item) }]} data-options hidden>
          {item.options.map((option) => (
            <li>
              <button type="button" class="choice-card" data-option={option.id} aria-pressed="false">
                <span set:html={formatText(option.label)} />
                <span class="choice-card__mark"><Icon name="check" /> Vaše volba</span>
              </button>
            </li>
          ))}
        </ul>

        <div class="sequence__feedback" role="status">
          <details class="disclosure" data-explanations>
            <summary>Zobrazit vysvětlení</summary>
            <div class="disclosure__body">
              {item.options.map((option) => (
                <div class:list={['feedback', `feedback--${option.tone}`]} data-feedback={option.id}>
                  <p class="feedback__choice">
                    <span data-choice-prefix>Když zvolíte:</span> <strong set:html={formatText(option.label)} />
                  </p>
                  <ToneLabel tone={option.tone} />
                  {option.response && <p set:html={formatText(option.response)} />}
                </div>
              ))}
              {/* Vysvětlení platí pro všechny volby – v HTML je jen jednou. */}
              {item.explanation && (
                <p class="sequence__explanation-label" data-nojs-label>
                  Vysvětlení:
                </p>
              )}
              {item.explanation && <p class="sequence__explanation" data-explanation set:html={formatText(item.explanation)} />}
            </div>
          </details>
        </div>

        <div class="sequence__controls" data-controls hidden>
          {i < count - 1 ? (
            <button type="button" class="button button--large" data-next hidden>
              Další {labelLower} <span aria-hidden="true">→</span>
            </button>
          ) : (
            count > 1 && (
              <div class="sequence__done" data-done hidden>
                <p class="sequence__summary" data-summary data-noun={summaryNoun} />
                <p>To byla poslední {labelLower}. Až budete připraveni, pokračujte tlačítkem „{nextLabel}“ dole.</p>
              </div>
            )
          )}
          {i > 0 && (
            <button type="button" class="button button--secondary" data-prev>
              <span aria-hidden="true">←</span> Předchozí {labelLower}
            </button>
          )}
        </div>
      </section>
    ))
  }
</choice-sequence>

<script>
  import { reveal } from '../../scripts/reveal';
  import { zOrZe } from '../../lib/text';

  /** „3×“ s popiskem tónu; nulové tóny se vynechají. */
  const TONES: [string, string][] = [
    ['ok', 'vhodnou možnost'],
    ['info', 'možnost k zamyšlení'],
    ['risk', 'riskantní možnost'],
  ];

  class ChoiceSequence extends HTMLElement {
    items: HTMLElement[] = [];

    connectedCallback() {
      this.items = Array.from(this.querySelectorAll<HTMLElement>(':scope > [data-item]'));
      this.items.forEach((item, index) => this.enhance(item, index));
      this.show(0, false);
      this.classList.add('is-enhanced');
    }

    enhance(item: HTMLElement, index: number) {
      item.querySelector<HTMLElement>('[data-options]')!.hidden = false;
      item.querySelector<HTMLElement>('[data-controls]')!.hidden = false;

      // Vysvětlení: místo rozbalovací části se ukáže jen to k vybrané možnosti.
      const details = item.querySelector<HTMLDetailsElement>('[data-explanations]')!;
      details.open = true;
      details.querySelector('summary')!.hidden = true;
      details.classList.remove('disclosure');
      item.querySelectorAll<HTMLElement>('[data-feedback]').forEach((panel) => (panel.hidden = true));
      item.querySelectorAll<HTMLElement>('[data-choice-prefix]').forEach((el) => (el.textContent = 'Vaše volba:'));
      item.querySelectorAll<HTMLElement>('[data-nojs-label], [data-explanation]').forEach((el) => (el.hidden = true));

      item.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((button) => {
        button.addEventListener('click', () => this.choose(item, button.dataset.option!));
      });
      item.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => this.show(index + 1, true));
      item.querySelector<HTMLButtonElement>('[data-prev]')?.addEventListener('click', () => this.show(index - 1, true));
    }

    choose(item: HTMLElement, option: string) {
      item.querySelectorAll<HTMLButtonElement>('[data-option]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.option === option));
      });
      let shown: HTMLElement | undefined;
      item.querySelectorAll<HTMLElement>('[data-feedback]').forEach((panel) => {
        panel.hidden = panel.dataset.feedback !== option;
        if (!panel.hidden) shown = panel;
      });
      // Společné vysvětlení se přesune do panelu zvolené možnosti (jedno hlášení, barva podle tónu).
      const explanation = item.querySelector<HTMLElement>('[data-explanation]');
      if (explanation && shown) {
        shown.append(explanation);
        explanation.hidden = false;
      }
      const next = item.querySelector<HTMLElement>('[data-next]');
      const done = item.querySelector<HTMLElement>('[data-done]');
      if (next) next.hidden = false;
      if (done) {
        done.hidden = false;
        this.summarize(done.querySelector<HTMLElement>('[data-summary]'));
      }
      // Zpětná vazba a tlačítko „Další“ bývají na tabletu pod okrajem – posuneme je do zorného pole.
      // Zaměření zůstává na zvoleném tlačítku; obsah přečte čtečka díky role="status".
      if (shown) reveal(shown, item.querySelector('[data-controls]') ?? shown);
    }

    /** Krátké shrnutí na konci řady (jen v paměti stránky, nic se neukládá ani nehodnotí). */
    summarize(target: HTMLElement | null) {
      if (!target) return;
      const tones = this.items
        .map((item) => item.querySelector<HTMLElement>('[data-feedback]:not([hidden])'))
        .map((panel) => TONES.find(([tone]) => panel?.classList.contains(`feedback--${tone}`))?.[0])
        .filter(Boolean) as string[];
      const total = this.items.length;
      const parts = TONES.map(([tone, label]) => [tones.filter((t) => t === tone).length, label] as const)
        .filter(([n]) => n > 0)
        .map(([n, label]) => `${label} ${n}×`);
      const noun = target.dataset.noun ?? 'položek';
      let text = tones.length === total ? `Prošli jste všech ${total} ${noun}.` : `Prošli jste ${tones.length} ${zOrZe(total)} ${total} ${noun}.`;
      // Počty tónů jen tam, kde aktivita rozlišuje vhodné a riskantní možnosti.
      if (tones.some((t) => t !== 'info')) text += ` Zvolili jste ${parts.join(', ')}.`;
      target.textContent = text;
    }

    show(index: number, moveFocus: boolean) {
      this.items.forEach((item, i) => (item.hidden = i !== index));
      if (!moveFocus) return;
      const target = this.items[index].querySelector<HTMLElement>('[data-counter]') ?? this.items[index];
      target.focus({ preventScroll: true });
      target.scrollIntoView({ block: 'start' });
    }
  }

  customElements.define('choice-sequence', ChoiceSequence);
</script>

<style>
  .sequence {
    display: block;
    margin: var(--space-3) 0;
  }

  .sequence__item {
    padding: var(--space-3);
    border: 2px solid var(--color-border-light);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .sequence__item + .sequence__item {
    margin-top: var(--space-3);
  }

  .sequence__counter {
    display: inline-block;
    margin-bottom: var(--space-2);
    padding: 0.15rem 0.8rem;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 700;
    scroll-margin-top: var(--space-3);
  }

  .sequence__text {
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* Situace s postavou: avatar vlevo od textu. */
  .sequence__persona {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .sequence__persona .sequence__text {
    margin: 0;
  }

  .sequence__question {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .sequence__feedback :global(.feedback) {
    margin-bottom: var(--space-2);
  }

  .sequence__explanation-label {
    margin-bottom: var(--space-1);
    font-weight: 700;
  }

  .sequence__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .sequence__summary {
    margin: 0 0 var(--space-1);
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--module-soft, var(--color-accent-soft));
    font-weight: 700;
  }

  .sequence__done p:last-child {
    margin: 0;
  }

  .sequence__done {
    margin: 0;
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .sequence__item {
      padding: 0.75rem;
      border-width: 1px;
    }
  }
</style>
