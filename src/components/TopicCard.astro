---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  topic: CollectionEntry<'topics'>;
  count: number;
  headingLevel?: 'h2' | 'h3';
}

const { topic, count, headingLevel: Heading = 'h2' } = Astro.props;
const countLabel = count === 1 ? '1 materiál' : count >= 2 && count <= 4 ? `${count} materiály` : `${count} materiálů`;
---

<article class="topic-card">
  {topic.data.icon && <span class="topic-card__icon" aria-hidden="true">{topic.data.icon}</span>}
  <Heading class="topic-card__title">
    <a href={withBase(`temata/${topic.id}/`)}>{topic.data.title}</a>
  </Heading>
  <p>{topic.data.description}</p>
  <p class="topic-card__count">{countLabel}</p>
</article>

<style>
  .topic-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    border: 3px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }

  .topic-card:hover {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }

  .topic-card__icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .topic-card__title {
    margin: var(--space-2) 0 var(--space-1);
  }

  /* Celá karta je klikací, ale pro čtečky obrazovky zůstává jediný odkaz. */
  .topic-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .topic-card:focus-within {
    outline: 4px solid var(--color-focus-text);
    outline-offset: 2px;
    box-shadow: 0 0 0 8px var(--color-focus);
  }

  .topic-card p {
    margin-bottom: var(--space-1);
  }

  .topic-card__count {
    margin-top: auto;
    padding-top: var(--space-1);
    color: var(--color-text-muted);
    font-weight: 600;
  }
</style>
