---
/** Čtyři způsoby, jak se útočníci dostávají k heslům (pořadí jako v bodech obrazovky). viewBox 800 × 450. */
import { ICONS } from '../../lib/icons';

const PANELS = [
  { x: 0, y: 0, title: ['Vylákají'], sub: ['falešnou stránkou', 'nebo zprávou'] },
  { x: 410, y: 0, title: ['Hádají z běžných', 'hesel'], sub: ['zkoušejí seznam', 'nejčastějších hesel'] },
  { x: 0, y: 232, title: ['Zkoušejí uniklá', 'hesla jinde'], sub: ['u e-mailu, banky', 'i obchodu'] },
  { x: 410, y: 232, title: ['Zkoušejí všechny', 'kombinace'], sub: ['krátké heslo', 'padne rychle'] },
];
const MONO = "ui-monospace, Menlo, Consolas, 'DejaVu Sans Mono', monospace";
const TEXT_X = 190;
const icon = (name: keyof typeof ICONS, x: number, y: number, scale: number, color: string) =>
  `<g transform="translate(${x} ${y}) scale(${scale})" stroke="${color}" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</g>`;
---

<svg viewBox="0 0 800 450" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  {
    PANELS.map((p, i) => (
      <g transform={`translate(${p.x} ${p.y})`}>
        <rect width="390" height="218" rx="18" fill="#fff8e8" stroke="#f0dfb8" stroke-width="2" />
        <circle cx="30" cy="32" r="18" fill="#935b08" />
        <text x="30" y="39" font-size="20" font-weight="700" text-anchor="middle" fill="#ffffff">
          {i + 1}
        </text>
        {p.title.map((line, li) => (
          <text x={TEXT_X} y={70 + li * 28} font-size="22" font-weight="700" fill="#1b2333">
            {line}
          </text>
        ))}
        {p.sub.map((line, li) => (
          <text x={TEXT_X} y={78 + p.title.length * 28 + li * 26} font-size="18" fill="#47556b">
            {line}
          </text>
        ))}
      </g>
    ))
  }

  <!-- 1 Vylákají: na háčku visí klíč -->
  <path d="M106 14 V86" stroke="#8a93a1" stroke-width="2.5"></path>
  <path d="M106 86 v34 a18 18 0 0 1 -36 0 v-12 l9 9" fill="none" stroke="#3d4650" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
  <g fill="none" stroke="#c98a1b" stroke-width="6" stroke-linecap="round">
    <circle cx="88" cy="150" r="13"></circle>
    <path d="M88 163 V206 M88 186 h12 M88 198 h9"></path>
  </g>

  <!-- 2 Hádají: seznam nejčastějších hesel -->
  <g transform="translate(410 0)">
    <rect x="30" y="44" width="124" height="160" rx="10" fill="#ffffff" stroke="#d9c9a3" stroke-width="3"></rect>
    <rect x="70" y="36" width="44" height="16" rx="4" fill="#935b08"></rect>
    <rect x="40" y="96" width="104" height="28" rx="5" fill="#fde7b0"></rect>
    <text x="48" y="84" font-size="19" font-family={MONO} fill="#1b2333">123456</text>
    <text x="48" y="117" font-size="19" font-family={MONO} font-weight="700" fill="#1b2333">heslo</text>
    <text x="48" y="150" font-size="19" font-family={MONO} fill="#1b2333">qwerty</text>
    <text x="48" y="183" font-size="19" font-family={MONO} fill="#1b2333">111111</text>
    <path d="M118 110 l5 5 9-10" fill="none" stroke="#935b08" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>

  <!-- 3 Zkoušejí uniklé heslo jinde: jeden klíč ke třem účtům -->
  <g transform="translate(0 232)">
    <g fill="none" stroke="#c98a1b" stroke-width="6" stroke-linecap="round">
      <circle cx="40" cy="125" r="13"></circle>
      <path d="M53 125 H84 M72 125 v10 M62 125 v8"></path>
    </g>
    <g fill="none" stroke="#c9a35a" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M92 120 Q110 74 132 72 M126 66 l6 6 -6 6"></path>
      <path d="M94 125 H132 M126 119 l6 6 -6 6"></path>
      <path d="M92 130 Q110 176 132 178 M126 172 l6 6 -6 6"></path>
    </g>
    <rect x="138" y="50" width="44" height="44" rx="10" fill="#ffffff" stroke="#d9c9a3" stroke-width="2"></rect>
    <rect x="138" y="103" width="44" height="44" rx="10" fill="#ffffff" stroke="#d9c9a3" stroke-width="2"></rect>
    <rect x="138" y="156" width="44" height="44" rx="10" fill="#ffffff" stroke="#d9c9a3" stroke-width="2"></rect>
    <Fragment set:html={icon('mail', 145, 57, 1.25, '#935b08') + icon('bank', 145, 110, 1.25, '#935b08') + icon('cart', 145, 163, 1.25, '#935b08')} />
  </g>

  <!-- 4 Zkoušejí všechny kombinace: počítač -->
  <g transform="translate(410 232)">
    <rect x="22" y="50" width="140" height="100" rx="8" fill="#1f2430"></rect>
    <rect x="30" y="58" width="124" height="84" rx="4" fill="#12301f"></rect>
    <text x="44" y="84" font-size="19" font-family={MONO} fill="#7ee2a0">aaaa</text>
    <text x="44" y="107" font-size="19" font-family={MONO} fill="#7ee2a0">aaab</text>
    <text x="44" y="130" font-size="19" font-family={MONO} fill="#7ee2a0">aaac…</text>
    <rect x="80" y="150" width="24" height="18" fill="#4a5568"></rect>
    <rect x="56" y="166" width="72" height="9" rx="4" fill="#4a5568"></rect>
  </g>
</svg>
