---
/** Časová osa hesel: starověký Řím, prohibice, Enigma, rok 1961 a dnešek. viewBox 800 × 380 (od y = 40). */
import { ICONS } from '../../lib/icons';

const STATIONS = [
  { x: 96, title: 'Starověký', sub: 'Řím' },
  { x: 248, title: 'Prohibice', sub: 'v USA' },
  { x: 400, title: '2. světová', sub: 'válka' },
  { x: 552, title: 'Rok 1961', sub: 'univerzita MIT' },
  { x: 704, title: 'Dnes', sub: 'desítky účtů' },
];
const TODAY = STATIONS.length - 1;
// Klávesy Enigmy: tři řady.
const keys = [
  { y: -4, n: 7 },
  { y: 8, n: 6 },
  { y: 20, n: 7 },
].flatMap((row) => Array.from({ length: row.n }, (_, i) => ({ x: (i - (row.n - 1) / 2) * 8.6, y: row.y })));
---

<svg viewBox="0 40 800 380" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <rect y="40" width="800" height="380" rx="24" fill="#fff8e8"></rect>

  <!-- Osa času -->
  <path d="M36 300 H750" stroke="#e2c88f" stroke-width="6" stroke-linecap="round"></path>
  <path d="M742 287 L760 300 L742 313" fill="none" stroke="#e2c88f" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>

  {
    STATIONS.map((s, i) => (
      <g>
        <path d={`M${s.x} 238 V290`} stroke="#e2c88f" stroke-width="3" />
        <circle cx={s.x} cy="300" r="10" fill={i === TODAY ? '#935b08' : '#c9a35a'} />
        <circle cx={s.x} cy="168" r="68" fill={i === TODAY ? '#fff1cf' : '#ffffff'} stroke={i === TODAY ? '#935b08' : '#e2c88f'} stroke-width="4" />
        <text x={s.x} y="346" font-size="21" font-weight="700" text-anchor="middle" fill="#1b2333">
          {s.title}
        </text>
        <text x={s.x} y="374" font-size="19" text-anchor="middle" fill="#47556b">
          {s.sub}
        </text>
      </g>
    ))
  }

  <!-- Řím: vosková destička a rydlo -->
  <g transform="translate(92 172) rotate(-8)">
    <rect x="-40" y="-30" width="80" height="60" rx="6" fill="#c8925a" stroke="#8a5a2b" stroke-width="3"></rect>
    <rect x="-31" y="-21" width="62" height="42" rx="3" fill="#4a3626"></rect>
    <path d="M-23 -9h44M-23 1h30M-23 11h38" stroke="#e2bb7e" stroke-width="3" stroke-linecap="round"></path>
  </g>
  <path d="M112 112 L138 176" stroke="#6b4a2e" stroke-width="5" stroke-linecap="round"></path>
  <path d="M138 176 L141 186" stroke="#c9ccd2" stroke-width="4" stroke-linecap="round"></path>

  <!-- Prohibice: dveře tajného baru s okénkem -->
  <g transform="translate(248 172)">
    <rect x="-32" y="-48" width="64" height="94" rx="4" fill="#7a4a2a" stroke="#5a3418" stroke-width="3"></rect>
    <rect x="-24" y="2" width="48" height="36" rx="2" fill="none" stroke="#5a3418" stroke-width="2"></rect>
    <rect x="-19" y="-36" width="38" height="16" rx="3" fill="#1b1f23"></rect>
    <circle cx="-7" cy="-28" r="3.2" fill="#ffffff"></circle>
    <circle cx="7" cy="-28" r="3.2" fill="#ffffff"></circle>
    <circle cx="22" cy="-4" r="4.5" fill="#e3b23c"></circle>
  </g>
  <path
    d="M262 90 H314 A12 12 0 0 1 326 102 V112 A12 12 0 0 1 314 124 H278 L256 138 L262 124 A12 12 0 0 1 250 112 V102 A12 12 0 0 1 262 90 Z"
    fill="#ffffff"
    stroke="#8a5a2b"
    stroke-width="2"
    stroke-linejoin="round"></path>
  <text x="288" y="113" font-size="18" font-weight="700" text-anchor="middle" fill="#5a3418">Heslo?</text>

  <!-- Enigma: dřevěná skříňka, válce a klávesy -->
  <g transform="translate(400 176)">
    <rect x="-24" y="-48" width="12" height="24" rx="3" fill="#c9ccd2" stroke="#4a3220" stroke-width="2"></rect>
    <rect x="-6" y="-48" width="12" height="24" rx="3" fill="#c9ccd2" stroke="#4a3220" stroke-width="2"></rect>
    <rect x="12" y="-48" width="12" height="24" rx="3" fill="#c9ccd2" stroke="#4a3220" stroke-width="2"></rect>
    <rect x="-44" y="-30" width="88" height="66" rx="6" fill="#6b4a2e" stroke="#4a3220" stroke-width="3"></rect>
    <rect x="-36" y="-22" width="72" height="50" rx="3" fill="#2b2f36"></rect>
    <path d="M-28 -13h56" stroke="#e6c46a" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.01 8.6"></path>
    {keys.map((k) => <circle cx={k.x} cy={k.y} r="3.3" fill="#e9e4d4" />)}
  </g>

  <!-- Rok 1961: terminál počítače -->
  <g transform="translate(552 172)">
    <rect x="-42" y="-48" width="84" height="60" rx="6" fill="#d9d4c7" stroke="#6b6658" stroke-width="3"></rect>
    <rect x="-34" y="-40" width="68" height="44" rx="3" fill="#12301f"></rect>
    <path d="M-26 -27h32" stroke="#7ee2a0" stroke-width="3" stroke-linecap="round"></path>
    <path d="M-26 -12h.01M-18 -12h.01M-10 -12h.01M-2 -12h.01" stroke="#7ee2a0" stroke-width="5" stroke-linecap="round"></path>
    <rect x="6" y="-17" width="6" height="10" fill="#7ee2a0"></rect>
    <rect x="-10" y="12" width="20" height="8" fill="#b8b2a3"></rect>
    <path d="M-46 20 h92 l7 20 h-106 Z" fill="#cfc9ba" stroke="#6b6658" stroke-width="3" stroke-linejoin="round"></path>
    <path d="M-36 30h72" stroke="#8b8577" stroke-width="4" stroke-dasharray="6 4"></path>
  </g>

  <!-- Dnes: tablet s polem pro heslo -->
  <g transform="translate(704 168)">
    <rect x="-36" y="-52" width="72" height="104" rx="12" fill="#1f2430"></rect>
    <rect x="-30" y="-44" width="60" height="86" rx="5" fill="#ffffff"></rect>
    <g transform="translate(-12 -40)" stroke="#935b08" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.lock}></g>
    <rect x="-23" y="-6" width="46" height="18" rx="4" fill="#f1f3f7" stroke="#8a93a1" stroke-width="1.5"></rect>
    <path d="M-14 3h.01M-7 3h.01M0 3h.01M7 3h.01M14 3h.01" stroke="#1b2333" stroke-width="4.5" stroke-linecap="round"></path>
    <rect x="-23" y="20" width="46" height="14" rx="4" fill="#245cce"></rect>
  </g>
</svg>
