---
/** Ukázková fotografie A: narozeninový dort na stole – nic neprozrazuje. viewBox 600 × 450. */
---

<svg viewBox="0 0 600 450" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <linearGradient id="ps-wall" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f3dcc4"></stop>
      <stop offset="1" stop-color="#e7c7a8"></stop>
    </linearGradient>
    <radialGradient id="ps-bokeh" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#fff3c4" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#fff3c4" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="ps-table" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b98457"></stop>
      <stop offset="1" stop-color="#8d5f3a"></stop>
    </linearGradient>
    <linearGradient id="ps-cake" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f2d2dc"></stop>
      <stop offset="0.5" stop-color="#fbe8ee"></stop>
      <stop offset="1" stop-color="#e9c0cd"></stop>
    </linearGradient>
    <linearGradient id="ps-plate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="1" stop-color="#dfe3ea"></stop>
    </linearGradient>
    <radialGradient id="ps-flame" cx="0.5" cy="0.7" r="0.6">
      <stop offset="0" stop-color="#fff7b0"></stop>
      <stop offset="1" stop-color="#ff9c2a"></stop>
    </radialGradient>
    <filter id="ps-soft" x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#5a3a1f" flood-opacity="0.35"></feDropShadow>
    </filter>
    <clipPath id="ps-photo"><rect x="16" y="16" width="568" height="418" rx="4"></rect></clipPath>
  </defs>

  <rect width="600" height="450" rx="10" fill="#ffffff"></rect>
  <rect x="0.5" y="0.5" width="599" height="449" rx="10" fill="none" stroke="#d6dbe3"></rect>
  <g clip-path="url(#ps-photo)">
    <rect x="16" y="16" width="568" height="418" fill="url(#ps-wall)"></rect>
    <!-- Rozostřená světélka v pozadí -->
    <circle cx="90" cy="80" r="34" fill="url(#ps-bokeh)"></circle>
    <circle cx="190" cy="60" r="22" fill="url(#ps-bokeh)"></circle>
    <circle cx="470" cy="70" r="40" fill="url(#ps-bokeh)"></circle>
    <circle cx="540" cy="150" r="24" fill="url(#ps-bokeh)"></circle>
    <circle cx="330" cy="40" r="18" fill="url(#ps-bokeh)"></circle>
    <!-- Stůl -->
    <rect x="16" y="285" width="568" height="149" fill="url(#ps-table)"></rect>
    <path d="M16 310 H584 M16 345 H584 M16 385 H584" stroke="#7a4f2e" stroke-width="2" opacity="0.35"></path>
    <!-- Váza s květinami -->
    <g filter="url(#ps-soft)">
      <path d="M470 290 C 462 250, 468 230, 478 220 L 512 220 C 522 230, 528 250, 520 290 Z" fill="#7fb3c9"></path>
      <ellipse cx="495" cy="220" rx="18" ry="5" fill="#5f97ae"></ellipse>
    </g>
    <path d="M488 220 C 480 180, 470 160, 455 140 M495 220 C 495 170, 500 150, 505 120 M502 220 C 515 185, 530 165, 545 150" stroke="#4f8a3c" stroke-width="4" fill="none"></path>
    <circle cx="455" cy="138" r="16" fill="#f4a3b6"></circle><circle cx="455" cy="138" r="6" fill="#f8d36b"></circle>
    <circle cx="505" cy="116" r="18" fill="#f7c35b"></circle><circle cx="505" cy="116" r="7" fill="#d9822b"></circle>
    <circle cx="546" cy="148" r="15" fill="#c9a0e8"></circle><circle cx="546" cy="148" r="5" fill="#f8d36b"></circle>
    <!-- Talíř a dort -->
    <ellipse cx="270" cy="330" rx="180" ry="38" fill="#6b4329" opacity="0.35"></ellipse>
    <ellipse cx="270" cy="318" rx="176" ry="36" fill="url(#ps-plate)"></ellipse>
    <g filter="url(#ps-soft)">
      <path d="M140 210 V300 C 140 322, 400 322, 400 300 V210 Z" fill="url(#ps-cake)"></path>
      <ellipse cx="270" cy="210" rx="130" ry="26" fill="#fdf1f4"></ellipse>
    </g>
    <path d="M140 222 C 160 240, 175 222, 195 240 C 215 256, 232 236, 252 252 C 272 266, 292 242, 312 256 C 332 268, 352 244, 372 258 C 386 266, 394 250, 400 240" stroke="#ffffff" stroke-width="10" fill="none" stroke-linecap="round"></path>
    <circle cx="200" cy="205" r="9" fill="#d23c5a"></circle>
    <circle cx="270" cy="198" r="9" fill="#d23c5a"></circle>
    <circle cx="340" cy="205" r="9" fill="#d23c5a"></circle>
    <!-- Svíčky -->
    <g>
      <rect x="226" y="150" width="9" height="48" rx="3" fill="#7fb3e6"></rect>
      <rect x="266" y="140" width="9" height="56" rx="3" fill="#f2b84b"></rect>
      <rect x="306" y="150" width="9" height="48" rx="3" fill="#9ed39a"></rect>
      <path d="M230.5 150 c -8 -10, -2 -22, 0 -26 c 2 4, 8 16, 0 26 Z" fill="url(#ps-flame)"></path>
      <path d="M270.5 140 c -8 -10, -2 -22, 0 -26 c 2 4, 8 16, 0 26 Z" fill="url(#ps-flame)"></path>
      <path d="M310.5 150 c -8 -10, -2 -22, 0 -26 c 2 4, 8 16, 0 26 Z" fill="url(#ps-flame)"></path>
    </g>
  </g>

  <!-- Označení fotografie -->
  <circle cx="54" cy="54" r="26" fill="#1b5e32"></circle>
  <text x="54" y="63" font-size="26" font-weight="700" text-anchor="middle" fill="#ffffff">A</text>
</svg>
