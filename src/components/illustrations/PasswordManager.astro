---
/**
 * Správce hesel jako trezor: uložená hesla a jedno hlavní heslo. Vpravo vyplní heslo
 * na pravé adrese a na napodobené ne. Adresy jsou smyšlené (.test). viewBox 800 × 450.
 */
import { ICONS } from '../../lib/icons';

const ENTRIES = [
  { icon: 'mail', name: 'E-mail' },
  { icon: 'bank', name: 'Banka' },
  { icon: 'cart', name: 'Obchod' },
  { icon: 'heart', name: 'Lékař' },
] as const;
const icon = (name: keyof typeof ICONS, x: number, y: number, scale: number, color: string, width = 2) =>
  `<g transform="translate(${x} ${y}) scale(${scale})" stroke="${color}" fill="none" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</g>`;
const DOTS = '••••••••';

const WINDOWS = [
  { y: 40, address: 'banka.test', ok: true, status: 'Správce heslo vyplnil' },
  { y: 240, address: 'banka-overeni.test', ok: false, status: 'Cizí adresa – heslo nevyplní' },
];
---

<svg viewBox="0 0 800 450" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <filter id="sh-shadow" x="-10%" y="-10%" width="125%" height="125%">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#0b1a33" flood-opacity="0.22"></feDropShadow>
    </filter>
  </defs>

  <!-- Trezor s otevřenými dvířky -->
  <g filter="url(#sh-shadow)">
    <rect x="30" y="40" width="270" height="310" rx="18" fill="#5b6475"></rect>
    <path d="M300 44 L354 70 V320 L300 346 Z" fill="#4a5262" stroke="#3a414e" stroke-width="2" stroke-linejoin="round"></path>
  </g>
  <rect x="46" y="56" width="238" height="278" rx="10" fill="#eef1f6"></rect>
  <circle cx="328" cy="196" r="17" fill="#c9ccd2" stroke="#2c3440" stroke-width="3"></circle>
  <path d="M328 183 v8" stroke="#2c3440" stroke-width="3" stroke-linecap="round"></path>
  <rect x="324" y="226" width="8" height="40" rx="4" fill="#c9ccd2"></rect>
  <rect x="48" y="350" width="34" height="10" rx="3" fill="#3a414e"></rect>
  <rect x="248" y="350" width="34" height="10" rx="3" fill="#3a414e"></rect>
  {
    ENTRIES.map((e, i) => {
      const y = 70 + i * 64;
      return (
        <g>
          <rect x="60" y={y} width="210" height="54" rx="8" fill="#ffffff" stroke="#c3cad6" stroke-width="2" />
          <Fragment set:html={icon(e.icon, 72, y + 15, 1, '#935b08')} />
          <text x="108" y={y + 24} font-size="19" font-weight="700" fill="#1b2333">
            {e.name}
          </text>
          <text x="108" y={y + 45} font-size="18" letter-spacing="2" fill="#47556b">
            {DOTS}
          </text>
        </g>
      );
    })
  }
  <Fragment set:html={icon('key', 40, 380, 1.3, '#764906')} />
  <text x="80" y="402" font-size="20" font-weight="700" fill="#764906">Pamatujete si jen</text>
  <text x="80" y="428" font-size="20" font-weight="700" fill="#764906">jedno hlavní heslo</text>

  <!-- Dvě přihlašovací okna -->
  {
    WINDOWS.map((w) => (
      <g filter="url(#sh-shadow)">
        <rect x="404" y={w.y} width="372" height="170" rx="14" fill="#ffffff" stroke={w.ok ? '#c3cad6' : '#e8b48a'} stroke-width="2" />
      </g>
    ))
  }
  {
    WINDOWS.map((w) => (
      <g>
        <path d={`M404 ${w.y + 42} V${w.y + 14} a14 14 0 0 1 14 -14 H762 a14 14 0 0 1 14 14 V${w.y + 42} Z`} fill={w.ok ? '#e9ecf1' : '#fbece0'} />
        <rect x="418" y={w.y + 8} width="344" height="27" rx="13.5" fill="#ffffff" />
        <Fragment set:html={icon('lock', 430, w.y + 12, 0.8, '#47556b')} />
        <text x="456" y={w.y + 28} font-size="18" fill="#1b2333">
          {w.address}
        </text>
        <text x="424" y={w.y + 74} font-size="18" font-weight="700" fill="#47556b">
          Heslo
        </text>
        <rect x="424" y={w.y + 84} width="248" height="40" rx="6" fill="#f4f6fa" stroke="#8a93a1" stroke-width="2" />
        {w.ok && (
          <text x="438" y={w.y + 112} font-size="22" letter-spacing="3" fill="#1b2333">
            {DOTS}
          </text>
        )}
        <circle cx="722" cy={w.y + 104} r="25" fill={w.ok ? '#e5f2e8' : '#fbece0'} stroke={w.ok ? '#2e8b57' : '#c2410c'} stroke-width="3" />
        <Fragment set:html={icon(w.ok ? 'check' : 'warning', 707.6, w.y + 89.6, 1.2, w.ok ? '#1b5e32' : '#84390a', 2.4)} />
        <text x="424" y={w.y + 154} font-size="19" font-weight="700" fill={w.ok ? '#1b5e32' : '#84390a'}>
          {w.status}
        </text>
      </g>
    ))
  }
</svg>
