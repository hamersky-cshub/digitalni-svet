---
/**
 * Čtyři způsoby sledování (IP adresa, cookies, neviditelný obrázek, otisk prohlížeče)
 * se skládají do reklamního profilu. Údaje v profilu jsou smyšlené. viewBox 800 × 450.
 */
import { ICONS } from '../../lib/icons';

const icon = (name: keyof typeof ICONS, x: number, y: number, scale: number, color: string, width = 2) =>
  `<g transform="translate(${x} ${y}) scale(${scale})" stroke="${color}" fill="none" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</g>`;

const SOURCES = [
  { icon: 'home', title: 'IP adresa', sub: 'odkud se připojujete', label: 'Bydlí:', value: 'Brno a okolí' },
  { icon: 'cookie', title: 'Cookies', sub: 'lístečky v prohlížeči', label: 'Zajímá se o:', value: 'zahradu, zájezdy' },
  { icon: 'eye', title: 'Neviditelný obrázek', sub: 'v e-mailu', label: 'E-maily čte:', value: 'ráno kolem 8:00' },
  { icon: 'fingerprint', title: 'Otisk prohlížeče', sub: 'model, jazyk, nastavení', label: 'Zařízení:', value: 'tablet, čeština' },
] as const;
const tileY = (i: number) => 20 + i * 106;
const rowY = (i: number) => 132 + i * 66;
---

<svg viewBox="0 0 800 450" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <!-- Šipky ke profilu -->
  <g fill="none" stroke="#d7a6c8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    {
      SOURCES.map((_, i) => {
        const y1 = tileY(i) + 44;
        const y2 = rowY(i) - 6;
        return <path d={`M330 ${y1} C392 ${y1} 400 ${y2} 446 ${y2} M438 ${y2 - 8} l8 8 -8 8`} />;
      })
    }
  </g>

  <!-- Zdroje údajů -->
  {
    SOURCES.map((s, i) => {
      const y = tileY(i);
      return (
        <g>
          <rect x="16" y={y} width="312" height="88" rx="16" fill="#ffffff" stroke="#ecc8e0" stroke-width="3" />
          <circle cx="56" cy={y + 44} r="28" fill="#f9eefa" />
          <Fragment set:html={icon(s.icon, 38, y + 26, 1.5, '#872e6e')} />
          <text x="98" y={y + 40} font-size="20" font-weight="700" fill="#1b2333">
            {s.title}
          </text>
          <text x="98" y={y + 66} font-size="18" fill="#47556b">
            {s.sub}
          </text>
        </g>
      );
    })
  }

  <!-- Reklamní profil -->
  <rect x="456" y="20" width="328" height="410" rx="18" fill="#ffffff" stroke="#a13783" stroke-width="3"></rect>
  <path d="M456 84 V38 a18 18 0 0 1 18 -18 H766 a18 18 0 0 1 18 18 V84 Z" fill="#a13783"></path>
  <circle cx="492" cy="52" r="20" fill="#ffffff"></circle>
  <Fragment set:html={icon('person', 478.8, 38.8, 1.1, '#a13783')} />
  <text x="524" y="60" font-size="22" font-weight="700" fill="#ffffff">Reklamní profil</text>
  {
    SOURCES.map((s, i) => {
      const y = rowY(i);
      return (
        <g>
          <Fragment set:html={icon(s.icon, 474, y - 18, 1.1, '#872e6e')} />
          <text x="512" y={y - 10} font-size="18" fill="#47556b">
            {s.label}
          </text>
          <text x="512" y={y + 15} font-size="20" font-weight="700" fill="#1b2333">
            {s.value}
          </text>
        </g>
      );
    })
  }
  <rect x="474" y="378" width="292" height="36" rx="18" fill="#f9eefa"></rect>
  <text x="620" y="402" font-size="18" font-weight="700" text-anchor="middle" fill="#872e6e">Reklama: zájezdy k moři</text>
</svg>
