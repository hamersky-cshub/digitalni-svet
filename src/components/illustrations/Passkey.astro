---
/**
 * Přístupový klíč: telefon potvrdí přihlášení otiskem prstu, obličejem nebo PINem.
 * Falešná stránka nemá co vylákat. Služba i adresa jsou smyšlené. viewBox 800 × 450.
 */
import { ICONS } from '../../lib/icons';

const icon = (name: keyof typeof ICONS, x: number, y: number, scale: number, color: string, width = 2) =>
  `<g transform="translate(${x} ${y}) scale(${scale})" stroke="${color}" fill="none" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round">${ICONS[name]}</g>`;

const METHODS = [
  { icon: 'fingerprint', label: 'Otisk prstu' },
  { icon: 'face', label: 'Obličej' },
  { icon: 'keypad', label: 'PIN zařízení' },
] as const;
---

<svg viewBox="0 0 800 450" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <filter id="pk-shadow" x="-15%" y="-10%" width="130%" height="125%">
      <feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#0b1a33" flood-opacity="0.25"></feDropShadow>
    </filter>
  </defs>

  <!-- Způsoby potvrzení -->
  <text x="24" y="78" font-size="20" font-weight="700" fill="#764906">Místo hesla:</text>
  {
    METHODS.map((m, i) => {
      const y = 96 + i * 90;
      return (
        <g>
          <rect x="24" y={y} width="236" height="70" rx="16" fill="#ffffff" stroke="#ead9b0" stroke-width="3" />
          <circle cx="62" cy={y + 35} r="25" fill="#fff5dd" />
          <Fragment set:html={icon(m.icon, 46.4, y + 19.4, 1.3, '#935b08')} />
          <text x="100" y={y + 42} font-size="20" font-weight="700" fill="#1b2333">
            {m.label}
          </text>
        </g>
      );
    })
  }

  <!-- Telefon s výzvou k přihlášení -->
  <g filter="url(#pk-shadow)">
    <rect x="296" y="20" width="208" height="410" rx="30" fill="#1f2430"></rect>
  </g>
  <rect x="306" y="30" width="188" height="390" rx="22" fill="#ffffff"></rect>
  <rect x="370" y="40" width="60" height="10" rx="5" fill="#1f2430"></rect>
  <text x="400" y="94" font-size="21" font-weight="700" text-anchor="middle" fill="#1b2333">Moje pošta</text>
  <text x="400" y="120" font-size="18" text-anchor="middle" fill="#47556b">Přihlášení</text>
  <circle cx="400" cy="196" r="56" fill="#fff5dd"></circle>
  <Fragment set:html={icon('fingerprint', 361.6, 157.6, 3.2, '#935b08', 1.6)} />
  <text x="400" y="290" font-size="21" font-weight="700" text-anchor="middle" fill="#1b2333">Přiložte prst</text>
  <text x="400" y="318" font-size="18" text-anchor="middle" fill="#47556b">nebo použijte</text>
  <text x="400" y="342" font-size="18" text-anchor="middle" fill="#47556b">obličej či PIN</text>
  <rect x="360" y="402" width="80" height="5" rx="2.5" fill="#c3cad6"></rect>

  <!-- Falešná stránka nemá co vylákat -->
  <g filter="url(#pk-shadow)">
    <rect x="540" y="96" width="236" height="250" rx="16" fill="#ffffff" stroke="#e8b48a" stroke-width="2"></rect>
  </g>
  <path d="M540 140 V112 a16 16 0 0 1 16 -16 H760 a16 16 0 0 1 16 16 V140 Z" fill="#fbece0"></path>
  <text x="658" y="126" font-size="18" text-anchor="middle" fill="#84390a">posta-login.test</text>
  <circle cx="658" cy="210" r="44" fill="#fbece0"></circle>
  <Fragment set:html={icon('hook', 629.2, 181.2, 2.4, '#84390a', 1.8)} />
  <path d="M628 180 L688 240" stroke="#84390a" stroke-width="5" stroke-linecap="round"></path>
  <text x="658" y="288" font-size="20" font-weight="700" text-anchor="middle" fill="#84390a">Falešná stránka</text>
  <text x="658" y="316" font-size="19" text-anchor="middle" fill="#84390a">nemá co vylákat</text>
</svg>
