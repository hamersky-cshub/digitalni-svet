---
/** Tablet s nabídkou sítí Wi-Fi v kavárně: skutečná síť a podvodná „Kavarna_Zdarma“. Vše je smyšlené. viewBox 800 × 560. */

/** Ikona síly signálu (tři oblouky). */
const arcs = (x: number, y: number) => [
  `M${x - 18} ${y - 4} Q${x} ${y - 22} ${x + 18} ${y - 4}`,
  `M${x - 11} ${y + 3} Q${x} ${y - 8} ${x + 11} ${y + 3}`,
];
---

<svg viewBox="0 0 800 560" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <linearGradient id="wf-bezel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3f47"></stop>
      <stop offset="1" stop-color="#1c1f24"></stop>
    </linearGradient>
    <linearGradient id="wf-glare" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.16"></stop>
      <stop offset="0.45" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
    <filter id="wf-shadow" x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#0b1a33" flood-opacity="0.28"></feDropShadow>
    </filter>
    <clipPath id="wf-screen"><rect x="62" y="44" width="676" height="472" rx="10"></rect></clipPath>
  </defs>

  <!-- Tablet -->
  <rect x="38" y="20" width="724" height="520" rx="34" fill="url(#wf-bezel)" filter="url(#wf-shadow)"></rect>
  <circle cx="400" cy="32" r="4" fill="#555b64"></circle>

  <g clip-path="url(#wf-screen)">
    <rect x="62" y="44" width="676" height="472" fill="#f2f3f7"></rect>
    <!-- Horní lišta nastavení -->
    <rect x="62" y="44" width="676" height="64" fill="#ffffff"></rect>
    <text x="96" y="86" font-size="26" font-weight="700" fill="#1b1f23">‹ Nastavení</text>
    <text x="400" y="86" font-size="26" font-weight="700" text-anchor="middle" fill="#1b1f23">Wi-Fi</text>

    <!-- Přepínač Wi-Fi -->
    <rect x="96" y="128" width="608" height="60" rx="12" fill="#ffffff"></rect>
    <text x="120" y="166" font-size="21" fill="#1b1f23">Wi-Fi</text>
    <rect x="620" y="142" width="62" height="34" rx="17" fill="#2e8b57"></rect>
    <circle cx="665" cy="159" r="14" fill="#ffffff"></circle>

    <text x="110" y="226" font-size="16" font-weight="700" fill="#5b6475">DOSTUPNÉ SÍTĚ</text>

    <!-- Seznam sítí -->
    <rect x="96" y="240" width="608" height="216" rx="12" fill="#ffffff"></rect>

    <!-- Skutečná síť kavárny -->
    <text x="120" y="282" font-size="22" fill="#1b1f23">Kavarna_U_Lipy</text>
    <text x="120" y="304" font-size="14" fill="#5b6475">🔒 Zabezpečená heslem</text>
    {arcs(660, 290).map((d) => <path d={d} fill="none" stroke="#1b1f23" stroke-width="4" stroke-linecap="round" />)}
    <circle cx="660" cy="296" r="4" fill="#1b1f23"></circle>
    <rect x="96" y="312" width="608" height="1.5" fill="#e3e6ec"></rect>

    <!-- Podvodná síť -->
    <text x="120" y="354" font-size="22" font-weight="700" fill="#1b1f23">Kavarna_Zdarma</text>
    <text x="120" y="376" font-size="14" fill="#5b6475">Otevřená síť – bez hesla</text>
    {arcs(660, 362).map((d) => <path d={d} fill="none" stroke="#1b1f23" stroke-width="4" stroke-linecap="round" />)}
    <circle cx="660" cy="368" r="4" fill="#1b1f23"></circle>
    <rect x="96" y="384" width="608" height="1.5" fill="#e3e6ec"></rect>

    <!-- Další síť v okolí -->
    <text x="120" y="426" font-size="22" fill="#1b1f23">Byt_Novakovi</text>
    <text x="120" y="446" font-size="14" fill="#5b6475">🔒 Zabezpečená heslem</text>
    <path d={arcs(660, 434)[1]} fill="none" stroke="#9aa3b1" stroke-width="4" stroke-linecap="round"></path>
    <circle cx="660" cy="440" r="4" fill="#9aa3b1"></circle>

    <rect x="62" y="44" width="676" height="472" fill="url(#wf-glare)"></rect>
  </g>

  <!-- Zvýraznění podvodné sítě -->
  <rect x="104" y="324" width="592" height="62" rx="12" fill="none" stroke="#e3a33b" stroke-width="5" stroke-dasharray="10 7"></rect>
  <rect x="440" y="332" width="168" height="44" rx="10" fill="#fff6c9" stroke="#e3a33b" stroke-width="2"></rect>
  <text x="524" y="360" font-size="16" font-weight="700" text-anchor="middle" fill="#7a2e0e">Která je pravá?</text>
</svg>
