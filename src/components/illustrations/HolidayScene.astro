---
/**
 * Modelová scéna „balení na dovolenou“. Všechny údaje jsou smyšlené.
 * Hledané údaje (SPZ, příspěvek, adresa, vstupenka, štítek, průkaz) mají písmo aspoň 15–20 jednotek,
 * aby byly čitelné i na tabletu na výšku. Souřadnice míst k prohlédnutí jsou v obsahu
 * (stops/…/04-fotografie.yaml) v procentech – při posunutí předmětů je upravte také. viewBox 800 × 640.
 */
---

<svg viewBox="0 0 800 640" role="presentation" aria-hidden="true" focusable="false" class="scene" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <linearGradient id="hs-wall" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f6efe2"></stop>
      <stop offset="1" stop-color="#e4d8c3"></stop>
    </linearGradient>
    <radialGradient id="hs-light" cx="0.25" cy="0.2" r="0.8">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="hs-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7fb6e3"></stop>
      <stop offset="1" stop-color="#d9ecf7"></stop>
    </linearGradient>
    <linearGradient id="hs-lawn" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9cbf86"></stop>
      <stop offset="1" stop-color="#7a9f69"></stop>
    </linearGradient>
    <linearGradient id="hs-car" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5d8fc2"></stop>
      <stop offset="0.55" stop-color="#3f6d9b"></stop>
      <stop offset="1" stop-color="#2d5279"></stop>
    </linearGradient>
    <linearGradient id="hs-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#eef7fd"></stop>
      <stop offset="1" stop-color="#b9d6ea"></stop>
    </linearGradient>
    <linearGradient id="hs-table" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d8b38a"></stop>
      <stop offset="1" stop-color="#b98d61"></stop>
    </linearGradient>
    <linearGradient id="hs-frame" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#94704a"></stop>
      <stop offset="1" stop-color="#5e4329"></stop>
    </linearGradient>
    <linearGradient id="hs-paper" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="1" stop-color="#eef0f2"></stop>
    </linearGradient>
    <linearGradient id="hs-case" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6f9583"></stop>
      <stop offset="1" stop-color="#46685a"></stop>
    </linearGradient>
    <linearGradient id="hs-metal" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e6e9ee"></stop>
      <stop offset="0.5" stop-color="#9aa1ab"></stop>
      <stop offset="1" stop-color="#d4d8de"></stop>
    </linearGradient>
    <linearGradient id="hs-brass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f1d77a"></stop>
      <stop offset="0.5" stop-color="#b8901f"></stop>
      <stop offset="1" stop-color="#e4c25a"></stop>
    </linearGradient>
    <linearGradient id="hs-id" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f1f6fc"></stop>
      <stop offset="0.5" stop-color="#dce8f5"></stop>
      <stop offset="1" stop-color="#e9e3f3"></stop>
    </linearGradient>
    <linearGradient id="hs-screen-glare" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.35"></stop>
      <stop offset="0.4" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
    <pattern id="hs-grain" width="160" height="40" patternUnits="userSpaceOnUse">
      <path d="M0 10 C 40 6, 80 14, 160 9 M0 26 C 50 30, 100 22, 160 27 M0 36 C 30 34, 90 38, 160 35" stroke="#a87b51" stroke-width="1.4" fill="none" opacity="0.45"></path>
    </pattern>
    <filter id="hs-shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="3" dy="7" stdDeviation="6" flood-color="#4a3420" flood-opacity="0.35"></feDropShadow>
    </filter>
    <filter id="hs-shadow-wall" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="4" dy="6" stdDeviation="5" flood-color="#5b4a33" flood-opacity="0.3"></feDropShadow>
    </filter>
  </defs>

  <!-- Stěna se světlem z okna -->
  <rect width="800" height="320" fill="url(#hs-wall)"></rect>
  <rect width="800" height="320" fill="url(#hs-light)"></rect>

  <!-- Okno s výhledem na auto -->
  <g filter="url(#hs-shadow-wall)">
    <rect x="30" y="30" width="320" height="236" rx="6" fill="#fbfbf9" stroke="#c9c4b8" stroke-width="6"></rect>
  </g>
  <rect x="39" y="39" width="302" height="218" fill="url(#hs-sky)"></rect>
  <ellipse cx="100" cy="72" rx="34" ry="11" fill="#ffffff" opacity="0.85"></ellipse>
  <ellipse cx="125" cy="64" rx="22" ry="10" fill="#ffffff" opacity="0.85"></ellipse>
  <ellipse cx="270" cy="86" rx="30" ry="9" fill="#ffffff" opacity="0.7"></ellipse>
  <rect x="39" y="166" width="302" height="16" fill="#8fa68d"></rect>
  <path d="M39 168 C 75 156, 110 162, 145 154 C 190 146, 245 160, 341 150 V182 H39 Z" fill="#7e9c78"></path>
  <rect x="39" y="196" width="302" height="61" fill="url(#hs-lawn)"></rect>
  <rect x="39" y="192" width="302" height="10" fill="#b9b3a5"></rect>
  <!-- Auto (zvětšené, aby byla SPZ čitelná) -->
  <g transform="translate(-34 -48) scale(1.25)">
    <ellipse cx="180" cy="236" rx="96" ry="8" fill="#2b3a2a" opacity="0.35"></ellipse>
    <rect x="95" y="160" width="170" height="62" rx="18" fill="url(#hs-car)"></rect>
    <path d="M125 160 L150 128 H215 L240 160 Z" fill="url(#hs-car)"></path>
    <path d="M140 158 L157 136 H182 V158 Z M190 158 V136 H210 L227 158 Z" fill="url(#hs-glass)"></path>
    <path d="M100 178 H260" stroke="#ffffff" stroke-width="3" opacity="0.35"></path>
    <rect x="100" y="182" width="16" height="9" rx="3" fill="#fff3c2"></rect>
    <rect x="246" y="182" width="14" height="9" rx="3" fill="#e35b4f"></rect>
    <circle cx="130" cy="224" r="15" fill="#22252a"></circle><circle cx="130" cy="224" r="6" fill="#a9afb8"></circle>
    <circle cx="232" cy="224" r="15" fill="#22252a"></circle><circle cx="232" cy="224" r="6" fill="#a9afb8"></circle>
    <rect x="133" y="195" width="94" height="24" rx="3" fill="#ffffff" stroke="#1b1f23" stroke-width="2"></rect>
    <rect x="133" y="195" width="11" height="24" fill="#2a4fa0"></rect>
    <text x="186" y="213" font-size="16" font-weight="700" text-anchor="middle" fill="#1b1f23">1AB 2345</text>
  </g>
  <line x1="322" y1="39" x2="322" y2="257" stroke="#c9c4b8" stroke-width="5"></line>
  <path d="M39 39 L110 39 L39 134 Z" fill="#ffffff" opacity="0.18"></path>
  <!-- Záclona -->
  <path d="M20 24 C 34 90, 20 170, 32 276 L 12 276 L 12 24 Z" fill="#efe4d0" opacity="0.9"></path>
  <path d="M360 24 C 346 90, 362 170, 350 276 L 370 276 L 370 24 Z" fill="#efe4d0" opacity="0.9"></path>

  <!-- Rodinná fotografie na zdi -->
  <g filter="url(#hs-shadow-wall)">
    <rect x="380" y="58" width="150" height="116" rx="4" fill="url(#hs-frame)"></rect>
  </g>
  <rect x="390" y="68" width="130" height="96" fill="#cfe3ee"></rect>
  <rect x="390" y="130" width="130" height="34" fill="#a9c79a"></rect>
  <circle cx="425" cy="102" r="13" fill="#e2b48f"></circle>
  <path d="M412 92 C 414 82, 436 82, 438 94 C 430 88, 420 88, 412 92 Z" fill="#6b4a32"></path>
  <rect x="410" y="117" width="30" height="40" rx="10" fill="#c0504d"></rect>
  <circle cx="462" cy="110" r="10" fill="#e2b48f"></circle>
  <path d="M452 106 C 452 96, 472 96, 472 106 C 466 102, 458 102, 452 106 Z" fill="#d9b55a"></path>
  <rect x="451" y="122" width="22" height="34" rx="8" fill="#4f81bd"></rect>
  <circle cx="494" cy="100" r="13" fill="#c9966b"></circle>
  <path d="M481 98 C 482 86, 506 86, 507 98 C 499 92, 489 92, 481 98 Z" fill="#9aa1ab"></path>
  <rect x="479" y="115" width="30" height="42" rx="10" fill="#6aa84f"></rect>
  <rect x="390" y="68" width="130" height="96" fill="url(#hs-screen-glare)"></rect>

  <!-- Stůl s texturou dřeva -->
  <rect y="316" width="800" height="324" fill="url(#hs-table)"></rect>
  <rect y="316" width="800" height="324" fill="url(#hs-grain)"></rect>
  <rect y="312" width="800" height="12" fill="#a77b51"></rect>
  <rect y="324" width="800" height="18" fill="#000000" opacity="0.06"></rect>

  <!-- Tablet s rozepsaným příspěvkem -->
  <g filter="url(#hs-shadow)">
    <path d="M650 304 L690 304 L684 322 L656 322 Z" fill="#2b2f36"></path>
    <rect x="548" y="108" width="242" height="196" rx="14" fill="#23262c"></rect>
  </g>
  <rect x="558" y="118" width="222" height="176" rx="4" fill="#ffffff"></rect>
  <rect x="558" y="118" width="222" height="30" rx="4" fill="#eef2f7"></rect>
  <text x="570" y="139" font-size="16" font-weight="700" fill="#1b1f23">Nový příspěvek</text>
  <circle cx="579" cy="170" r="11" fill="#e2b48f"></circle>
  <text x="597" y="176" font-size="17" fill="#4a5568">Jana U.</text>
  <text x="570" y="210" font-size="18" fill="#1b1f23">Zítra letíme k moři!</text>
  <text x="570" y="236" font-size="18" fill="#1b1f23">Celé dva týdny pryč.</text>
  <rect x="570" y="250" width="132" height="32" rx="16" fill="#0b4566"></rect>
  <text x="636" y="272" font-size="16" font-weight="700" text-anchor="middle" fill="#ffffff">🌐 Veřejně</text>
  <rect x="558" y="118" width="222" height="176" rx="4" fill="url(#hs-screen-glare)"></rect>

  <!-- Obálka s adresou -->
  <g transform="rotate(-3 155 415)" filter="url(#hs-shadow)">
    <rect x="25" y="340" width="260" height="150" rx="4" fill="url(#hs-paper)" stroke="#c4c8ce" stroke-width="1.5"></rect>
    <path d="M25 340 L155 392 L285 340" fill="none" stroke="#dde0e4" stroke-width="2"></path>
    <rect x="230" y="352" width="40" height="46" fill="#e8c46a" stroke="#ffffff" stroke-width="3" stroke-dasharray="3 2"></rect>
    <circle cx="250" cy="375" r="10" fill="#c79a2e" opacity="0.7"></circle>
    <path d="M210 364 C 218 358, 226 370, 234 364 C 242 358, 250 370, 258 364" stroke="#7a7f88" stroke-width="1.5" fill="none" opacity="0.7"></path>
    <text x="45" y="422" font-size="20" fill="#1b1f23">Jana Ukázková</text>
    <text x="45" y="446" font-size="20" fill="#1b1f23">Vzorová 12</text>
    <text x="45" y="470" font-size="20" fill="#1b1f23">123 45 Městečko</text>
  </g>

  <!-- Palubní vstupenka -->
  <g transform="rotate(4 435 397)" filter="url(#hs-shadow)">
    <rect x="300" y="335" width="270" height="125" rx="8" fill="url(#hs-paper)" stroke="#3f6d9b" stroke-width="2"></rect>
    <rect x="300" y="335" width="270" height="30" rx="8" fill="#3f6d9b"></rect>
    <rect x="300" y="355" width="270" height="10" fill="#3f6d9b"></rect>
    <text x="314" y="356" font-size="15" font-weight="700" fill="#ffffff">PALUBNÍ VSTUPENKA ✈</text>
    <text x="314" y="393" font-size="20" font-weight="700" fill="#1b1f23">PRAHA → MÁLAGA</text>
    <text x="314" y="418" font-size="16" fill="#1b1f23">UKÁZKOVÁ JANA</text>
    <text x="314" y="442" font-size="16" fill="#1b1f23">14. 7.</text>
    <path d="M500 365 V460" stroke="#9aa1ab" stroke-width="1.5" stroke-dasharray="4 3"></path>
    <g fill="#1b1f23">
      <rect x="512" y="384" width="46" height="46" fill="#ffffff" stroke="#1b1f23" stroke-width="2"></rect>
      <rect x="517" y="389" width="12" height="12"></rect><rect x="541" y="389" width="12" height="12"></rect>
      <rect x="517" y="413" width="12" height="12"></rect><rect x="533" y="405" width="7" height="7"></rect>
      <rect x="543" y="415" width="9" height="9"></rect>
    </g>
  </g>

  <!-- Kufr (dokreslení scény) -->
  <g filter="url(#hs-shadow)">
    <rect x="600" y="345" width="170" height="115" rx="14" fill="url(#hs-case)"></rect>
  </g>
  <rect x="660" y="331" width="50" height="16" rx="6" fill="none" stroke="#33503f" stroke-width="6"></rect>
  <line x1="625" y1="345" x2="625" y2="460" stroke="#3d5c4e" stroke-width="5"></line>
  <line x1="745" y1="345" x2="745" y2="460" stroke="#3d5c4e" stroke-width="5"></line>
  <rect x="606" y="352" width="158" height="8" rx="4" fill="#ffffff" opacity="0.18"></rect>
  <rect x="668" y="392" width="34" height="18" rx="3" fill="url(#hs-metal)"></rect>

  <!-- Klíče se štítkem -->
  <g filter="url(#hs-shadow)">
    <rect x="40" y="520" width="120" height="42" rx="6" fill="#fdf6e8" stroke="#b5a98f" stroke-width="1.5"></rect>
    <text x="98" y="548" font-size="18" text-anchor="middle" fill="#1b1f23">Vzorová 12</text>
    <circle cx="178" cy="541" r="18" fill="none" stroke="url(#hs-metal)" stroke-width="5"></circle>
    <path d="M191 552 L226 578 L219 587 L213 581 L208 587 L201 581 L186 564 Z" fill="url(#hs-brass)"></path>
    <path d="M168 557 L150 594 L160 598 L165 589 L172 591 L177 582 L181 564 Z" fill="url(#hs-metal)"></path>
  </g>

  <!-- Občanský průkaz -->
  <g transform="rotate(-5 410 545)" filter="url(#hs-shadow)">
    <rect x="300" y="478" width="220" height="135" rx="10" fill="url(#hs-id)" stroke="#8fa6c4" stroke-width="1.5"></rect>
    <text x="314" y="502" font-size="15" font-weight="700" fill="#1b1f23">OBČANSKÝ PRŮKAZ</text>
    <rect x="314" y="512" width="56" height="72" rx="3" fill="#c7d3e3"></rect>
    <circle cx="342" cy="536" r="13" fill="#9fb0c8"></circle>
    <path d="M320 584 C 323 562, 361 562, 364 584 Z" fill="#9fb0c8"></path>
    <text x="384" y="534" font-size="17" fill="#1b1f23">UKÁZKOVÁ</text>
    <text x="384" y="558" font-size="17" fill="#1b1f23">Jana</text>
    <text x="384" y="582" font-size="15" fill="#1b1f23">č. 000000000</text>
    <circle cx="498" cy="596" r="10" fill="#cdb8e6" opacity="0.8"></circle>
  </g>

  <!-- Hrnek s kávou (pro dokreslení scény) -->
  <g filter="url(#hs-shadow)">
    <ellipse cx="735" cy="592" rx="32" ry="9" fill="#d9d4cc"></ellipse>
    <rect x="712" y="552" width="46" height="40" rx="8" fill="#f4f1ea"></rect>
    <path d="M758 562 C 774 562, 774 582, 758 582" stroke="#f4f1ea" stroke-width="6" fill="none"></path>
    <ellipse cx="735" cy="554" rx="23" ry="6" fill="#6b4529"></ellipse>
  </g>
</svg>
