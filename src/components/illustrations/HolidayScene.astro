---
/**
 * Modelová scéna „balení na dovolenou“. Všechny údaje jsou smyšlené.
 * Souřadnice míst k prohlédnutí jsou v obsahu (stops/…/04-fotografie.yaml) v procentech
 * – při posunutí předmětů je upravte také. viewBox 800 × 600.
 */
---

<svg viewBox="0 0 800 600" role="presentation" aria-hidden="true" focusable="false" class="scene" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <linearGradient id="hs-wall" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f6efe2"></stop>
      <stop offset="1" stop-color="#e4d8c3"></stop>
    </linearGradient>
    <radialGradient id="hs-light" cx="0.25" cy="0.2" r="0.8">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="hs-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7fb6e3"></stop>
      <stop offset="1" stop-color="#d9ecf7"></stop>
    </linearGradient>
    <linearGradient id="hs-lawn" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9cbf86"></stop>
      <stop offset="1" stop-color="#7a9f69"></stop>
    </linearGradient>
    <linearGradient id="hs-car" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5d8fc2"></stop>
      <stop offset="0.55" stop-color="#3f6d9b"></stop>
      <stop offset="1" stop-color="#2d5279"></stop>
    </linearGradient>
    <linearGradient id="hs-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#eef7fd"></stop>
      <stop offset="1" stop-color="#b9d6ea"></stop>
    </linearGradient>
    <linearGradient id="hs-table" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d8b38a"></stop>
      <stop offset="1" stop-color="#b98d61"></stop>
    </linearGradient>
    <linearGradient id="hs-frame" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#94704a"></stop>
      <stop offset="1" stop-color="#5e4329"></stop>
    </linearGradient>
    <linearGradient id="hs-paper" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="1" stop-color="#eef0f2"></stop>
    </linearGradient>
    <linearGradient id="hs-case" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6f9583"></stop>
      <stop offset="1" stop-color="#46685a"></stop>
    </linearGradient>
    <linearGradient id="hs-metal" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e6e9ee"></stop>
      <stop offset="0.5" stop-color="#9aa1ab"></stop>
      <stop offset="1" stop-color="#d4d8de"></stop>
    </linearGradient>
    <linearGradient id="hs-brass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f1d77a"></stop>
      <stop offset="0.5" stop-color="#b8901f"></stop>
      <stop offset="1" stop-color="#e4c25a"></stop>
    </linearGradient>
    <linearGradient id="hs-id" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f1f6fc"></stop>
      <stop offset="0.5" stop-color="#dce8f5"></stop>
      <stop offset="1" stop-color="#e9e3f3"></stop>
    </linearGradient>
    <linearGradient id="hs-screen-glare" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.35"></stop>
      <stop offset="0.4" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
    <pattern id="hs-grain" width="160" height="40" patternUnits="userSpaceOnUse">
      <path d="M0 10 C 40 6, 80 14, 160 9 M0 26 C 50 30, 100 22, 160 27 M0 36 C 30 34, 90 38, 160 35" stroke="#a87b51" stroke-width="1.4" fill="none" opacity="0.45"></path>
    </pattern>
    <filter id="hs-shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="3" dy="7" stdDeviation="6" flood-color="#4a3420" flood-opacity="0.35"></feDropShadow>
    </filter>
    <filter id="hs-shadow-wall" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="4" dy="6" stdDeviation="5" flood-color="#5b4a33" flood-opacity="0.3"></feDropShadow>
    </filter>
  </defs>

  <!-- Stěna se světlem z okna -->
  <rect width="800" height="330" fill="url(#hs-wall)"></rect>
  <rect width="800" height="330" fill="url(#hs-light)"></rect>

  <!-- Okno s výhledem na auto -->
  <g filter="url(#hs-shadow-wall)">
    <rect x="40" y="36" width="290" height="226" rx="6" fill="#fbfbf9" stroke="#c9c4b8" stroke-width="6"></rect>
  </g>
  <rect x="49" y="45" width="272" height="208" fill="url(#hs-sky)"></rect>
  <ellipse cx="110" cy="80" rx="34" ry="11" fill="#ffffff" opacity="0.85"></ellipse>
  <ellipse cx="135" cy="72" rx="22" ry="10" fill="#ffffff" opacity="0.85"></ellipse>
  <ellipse cx="262" cy="96" rx="30" ry="9" fill="#ffffff" opacity="0.7"></ellipse>
  <rect x="49" y="170" width="272" height="16" fill="#8fa68d"></rect>
  <path d="M49 172 C 80 160, 110 166, 140 158 C 180 150, 230 164, 321 154 V186 H49 Z" fill="#7e9c78"></path>
  <rect x="49" y="200" width="272" height="53" fill="url(#hs-lawn)"></rect>
  <rect x="49" y="196" width="272" height="10" fill="#b9b3a5"></rect>
  <g>
    <ellipse cx="180" cy="236" rx="96" ry="8" fill="#2b3a2a" opacity="0.35"></ellipse>
    <rect x="95" y="160" width="170" height="62" rx="18" fill="url(#hs-car)"></rect>
    <path d="M125 160 L150 128 H215 L240 160 Z" fill="url(#hs-car)"></path>
    <path d="M140 158 L157 136 H182 V158 Z M190 158 V136 H210 L227 158 Z" fill="url(#hs-glass)"></path>
    <path d="M100 178 H260" stroke="#ffffff" stroke-width="3" opacity="0.35"></path>
    <rect x="100" y="186" width="16" height="9" rx="3" fill="#fff3c2"></rect>
    <rect x="246" y="186" width="14" height="9" rx="3" fill="#e35b4f"></rect>
    <circle cx="130" cy="224" r="15" fill="#22252a"></circle><circle cx="130" cy="224" r="6" fill="#a9afb8"></circle>
    <circle cx="232" cy="224" r="15" fill="#22252a"></circle><circle cx="232" cy="224" r="6" fill="#a9afb8"></circle>
    <rect x="140" y="196" width="80" height="22" rx="3" fill="#ffffff" stroke="#1b1f23" stroke-width="2"></rect>
    <rect x="140" y="196" width="10" height="22" fill="#2a4fa0"></rect>
    <text x="186" y="212" font-size="13" font-weight="700" text-anchor="middle" fill="#1b1f23">1AB 2345</text>
  </g>
  <line x1="292" y1="45" x2="292" y2="253" stroke="#c9c4b8" stroke-width="5"></line>
  <path d="M49 45 L120 45 L49 140 Z" fill="#ffffff" opacity="0.18"></path>
  <!-- Záclona -->
  <path d="M30 30 C 44 90, 30 170, 42 270 L 22 270 L 22 30 Z" fill="#efe4d0" opacity="0.9"></path>
  <path d="M340 30 C 326 90, 342 170, 330 270 L 350 270 L 350 30 Z" fill="#efe4d0" opacity="0.9"></path>

  <!-- Rodinná fotografie na zdi -->
  <g filter="url(#hs-shadow-wall)">
    <rect x="380" y="58" width="150" height="116" rx="4" fill="url(#hs-frame)"></rect>
  </g>
  <rect x="390" y="68" width="130" height="96" fill="#cfe3ee"></rect>
  <rect x="390" y="130" width="130" height="34" fill="#a9c79a"></rect>
  <circle cx="425" cy="102" r="13" fill="#e2b48f"></circle>
  <path d="M412 92 C 414 82, 436 82, 438 94 C 430 88, 420 88, 412 92 Z" fill="#6b4a32"></path>
  <rect x="410" y="117" width="30" height="40" rx="10" fill="#c0504d"></rect>
  <circle cx="462" cy="110" r="10" fill="#e2b48f"></circle>
  <path d="M452 106 C 452 96, 472 96, 472 106 C 466 102, 458 102, 452 106 Z" fill="#d9b55a"></path>
  <rect x="451" y="122" width="22" height="34" rx="8" fill="#4f81bd"></rect>
  <circle cx="494" cy="100" r="13" fill="#c9966b"></circle>
  <path d="M481 98 C 482 86, 506 86, 507 98 C 499 92, 489 92, 481 98 Z" fill="#9aa1ab"></path>
  <rect x="479" y="115" width="30" height="42" rx="10" fill="#6aa84f"></rect>
  <rect x="390" y="68" width="130" height="96" fill="url(#hs-screen-glare)"></rect>

  <!-- Stůl s texturou dřeva -->
  <rect y="320" width="800" height="280" fill="url(#hs-table)"></rect>
  <rect y="320" width="800" height="280" fill="url(#hs-grain)"></rect>
  <rect y="316" width="800" height="12" fill="#a77b51"></rect>
  <rect y="328" width="800" height="18" fill="#000000" opacity="0.06"></rect>

  <!-- Tablet s rozepsaným příspěvkem -->
  <g filter="url(#hs-shadow)">
    <path d="M660 314 L700 314 L692 330 L668 330 Z" fill="#2b2f36"></path>
    <rect x="590" y="186" width="180" height="128" rx="12" fill="#23262c"></rect>
  </g>
  <rect x="600" y="196" width="160" height="108" rx="4" fill="#ffffff"></rect>
  <rect x="600" y="196" width="160" height="18" rx="4" fill="#eef2f7"></rect>
  <text x="610" y="209" font-size="11" font-weight="700" fill="#1b1f23">Nový příspěvek</text>
  <circle cx="616" cy="228" r="7" fill="#e2b48f"></circle>
  <text x="628" y="232" font-size="10" fill="#5b6475">Jana U.</text>
  <text x="610" y="252" font-size="12" fill="#1b1f23">Zítra letíme k moři!</text>
  <text x="610" y="268" font-size="12" fill="#1b1f23">Celé dva týdny pryč.</text>
  <rect x="610" y="278" width="80" height="20" rx="10" fill="#0b4566"></rect>
  <text x="650" y="292" font-size="11" font-weight="700" text-anchor="middle" fill="#ffffff">🌐 Veřejně</text>
  <rect x="600" y="196" width="160" height="108" rx="4" fill="url(#hs-screen-glare)"></rect>

  <!-- Obálka s adresou -->
  <g transform="rotate(-3 160 417)" filter="url(#hs-shadow)">
    <rect x="40" y="350" width="245" height="135" rx="4" fill="url(#hs-paper)" stroke="#c4c8ce" stroke-width="1.5"></rect>
    <path d="M40 350 L162 420 L285 350" fill="none" stroke="#dde0e4" stroke-width="2"></path>
    <rect x="232" y="362" width="38" height="44" fill="#e8c46a" stroke="#ffffff" stroke-width="3" stroke-dasharray="3 2"></rect>
    <circle cx="251" cy="384" r="10" fill="#c79a2e" opacity="0.7"></circle>
    <path d="M214 372 C 222 366, 230 378, 238 372 C 246 366, 254 378, 262 372" stroke="#7a7f88" stroke-width="1.5" fill="none" opacity="0.7"></path>
    <text x="60" y="420" font-size="14" fill="#1b1f23">Jana Ukázková</text>
    <text x="60" y="440" font-size="14" fill="#1b1f23">Vzorová 12</text>
    <text x="60" y="460" font-size="14" fill="#1b1f23">123 45 Městečko</text>
  </g>

  <!-- Palubní vstupenka -->
  <g transform="rotate(4 425 395)" filter="url(#hs-shadow)">
    <rect x="310" y="345" width="235" height="100" rx="8" fill="url(#hs-paper)" stroke="#3f6d9b" stroke-width="2"></rect>
    <rect x="310" y="345" width="235" height="24" rx="8" fill="#3f6d9b"></rect>
    <rect x="310" y="360" width="235" height="9" fill="#3f6d9b"></rect>
    <text x="322" y="362" font-size="12" font-weight="700" fill="#ffffff">PALUBNÍ VSTUPENKA ✈</text>
    <text x="322" y="390" font-size="15" font-weight="700" fill="#1b1f23">PRAHA → MÁLAGA</text>
    <text x="322" y="410" font-size="12" fill="#1b1f23">UKÁZKOVÁ JANA · 14. 7.</text>
    <path d="M490 369 V445" stroke="#9aa1ab" stroke-width="1.5" stroke-dasharray="4 3"></path>
    <g fill="#1b1f23">
      <rect x="500" y="384" width="34" height="34" fill="#ffffff" stroke="#1b1f23" stroke-width="2"></rect>
      <rect x="504" y="388" width="9" height="9"></rect><rect x="521" y="388" width="9" height="9"></rect>
      <rect x="504" y="405" width="9" height="9"></rect><rect x="516" y="400" width="5" height="5"></rect>
      <rect x="523" y="407" width="6" height="6"></rect>
      <rect x="322" y="420" width="3" height="16"></rect><rect x="328" y="420" width="1.5" height="16"></rect>
      <rect x="333" y="420" width="4" height="16"></rect><rect x="341" y="420" width="2" height="16"></rect>
      <rect x="346" y="420" width="3" height="16"></rect><rect x="353" y="420" width="1.5" height="16"></rect>
      <rect x="358" y="420" width="4" height="16"></rect><rect x="366" y="420" width="2" height="16"></rect>
      <rect x="371" y="420" width="3" height="16"></rect><rect x="378" y="420" width="1.5" height="16"></rect>
      <rect x="383" y="420" width="4" height="16"></rect><rect x="391" y="420" width="2" height="16"></rect>
    </g>
  </g>

  <!-- Kufr -->
  <g filter="url(#hs-shadow)">
    <rect x="585" y="360" width="190" height="130" rx="14" fill="url(#hs-case)"></rect>
  </g>
  <rect x="655" y="345" width="50" height="18" rx="6" fill="none" stroke="#33503f" stroke-width="6"></rect>
  <line x1="610" y1="360" x2="610" y2="490" stroke="#3d5c4e" stroke-width="5"></line>
  <line x1="750" y1="360" x2="750" y2="490" stroke="#3d5c4e" stroke-width="5"></line>
  <rect x="592" y="368" width="176" height="8" rx="4" fill="#ffffff" opacity="0.18"></rect>
  <rect x="664" y="410" width="34" height="20" rx="3" fill="url(#hs-metal)"></rect>

  <!-- Klíče se štítkem -->
  <g filter="url(#hs-shadow)">
    <rect x="258" y="494" width="58" height="28" rx="4" fill="#fdf6e8" stroke="#b5a98f" stroke-width="1.5"></rect>
    <text x="287" y="512" font-size="10" text-anchor="middle" fill="#1b1f23">Vzorová 12</text>
    <circle cx="330" cy="515" r="16" fill="none" stroke="url(#hs-metal)" stroke-width="5"></circle>
    <path d="M342 525 L372 548 L366 556 L360 551 L356 556 L350 551 L336 535 Z" fill="url(#hs-brass)"></path>
    <path d="M316 527 L300 560 L309 563 L313 555 L319 557 L323 549 L325 533 Z" fill="url(#hs-metal)"></path>
  </g>

  <!-- Občanský průkaz -->
  <g transform="rotate(-5 505 517)" filter="url(#hs-shadow)">
    <rect x="430" y="470" width="150" height="95" rx="8" fill="url(#hs-id)" stroke="#8fa6c4" stroke-width="1.5"></rect>
    <text x="440" y="488" font-size="10" font-weight="700" fill="#1b1f23">OBČANSKÝ PRŮKAZ</text>
    <rect x="440" y="496" width="38" height="48" rx="2" fill="#c7d3e3"></rect>
    <circle cx="459" cy="512" r="9" fill="#9fb0c8"></circle>
    <path d="M444 544 C 446 528, 472 528, 474 544 Z" fill="#9fb0c8"></path>
    <text x="486" y="510" font-size="10" fill="#1b1f23">UKÁZKOVÁ</text>
    <text x="486" y="524" font-size="10" fill="#1b1f23">Jana</text>
    <text x="486" y="538" font-size="10" fill="#1b1f23">č. 000000000</text>
    <circle cx="560" cy="550" r="9" fill="#cdb8e6" opacity="0.8"></circle>
  </g>

  <!-- Hrnek s kávou (pro dokreslení scény) -->
  <g filter="url(#hs-shadow)">
    <ellipse cx="740" cy="560" rx="30" ry="9" fill="#d9d4cc"></ellipse>
    <rect x="718" y="522" width="44" height="38" rx="8" fill="#f4f1ea"></rect>
    <path d="M762 532 C 778 532, 778 552, 762 552" stroke="#f4f1ea" stroke-width="6" fill="none"></path>
    <ellipse cx="740" cy="524" rx="22" ry="6" fill="#6b4529"></ellipse>
  </g>
</svg>
