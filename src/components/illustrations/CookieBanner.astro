---
/** Tablet se zpravodajským webem a lištou s cookies. Web „Denní zprávy“ je smyšlený. viewBox 800 × 560. */
---

<svg viewBox="0 0 800 560" aria-hidden="true" focusable="false" font-family="'Atkinson Hyperlegible Next', system-ui, sans-serif">
  <defs>
    <linearGradient id="cb-bezel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3f47"></stop>
      <stop offset="1" stop-color="#1c1f24"></stop>
    </linearGradient>
    <linearGradient id="cb-photo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9cc3e6"></stop>
      <stop offset="0.6" stop-color="#cfe3f3"></stop>
      <stop offset="1" stop-color="#e9dcc3"></stop>
    </linearGradient>
    <linearGradient id="cb-glare" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.18"></stop>
      <stop offset="0.45" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
    <filter id="cb-shadow" x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#0b1a33" flood-opacity="0.28"></feDropShadow>
    </filter>
    <filter id="cb-banner-shadow" x="-5%" y="-30%" width="110%" height="160%">
      <feDropShadow dx="0" dy="-6" stdDeviation="10" flood-color="#0b1a33" flood-opacity="0.25"></feDropShadow>
    </filter>
    <clipPath id="cb-screen"><rect x="62" y="44" width="676" height="472" rx="10"></rect></clipPath>
  </defs>

  <!-- Tablet -->
  <rect x="38" y="20" width="724" height="520" rx="34" fill="url(#cb-bezel)" filter="url(#cb-shadow)"></rect>
  <circle cx="400" cy="32" r="4" fill="#555b64"></circle>

  <g clip-path="url(#cb-screen)">
    <rect x="62" y="44" width="676" height="472" fill="#f7f8fa"></rect>
    <!-- Adresní řádek -->
    <rect x="62" y="44" width="676" height="40" fill="#e9ecf1"></rect>
    <rect x="200" y="53" width="400" height="22" rx="11" fill="#ffffff"></rect>
    <text x="400" y="69" font-size="13" text-anchor="middle" fill="#5b6475">dennizpravy.test</text>
    <!-- Hlavička webu -->
    <rect x="62" y="84" width="676" height="54" fill="#1d4f91"></rect>
    <text x="88" y="119" font-size="24" font-weight="700" fill="#ffffff">Denní zprávy</text>
    <text x="560" y="117" font-size="15" fill="#d6e4f7">Domov · Svět · Sport</text>
    <!-- Článek -->
    <rect x="88" y="160" width="360" height="200" rx="6" fill="url(#cb-photo)"></rect>
    <path d="M88 330 L180 260 L250 310 L320 250 L448 340 L448 360 L88 360 Z" fill="#7da36f" opacity="0.8"></path>
    <circle cx="390" cy="205" r="22" fill="#fff4c9"></circle>
    <rect x="470" y="164" width="240" height="18" rx="4" fill="#2b3340"></rect>
    <rect x="470" y="192" width="200" height="18" rx="4" fill="#2b3340"></rect>
    <rect x="470" y="226" width="240" height="10" rx="3" fill="#b9c1cc"></rect>
    <rect x="470" y="244" width="230" height="10" rx="3" fill="#b9c1cc"></rect>
    <rect x="470" y="262" width="240" height="10" rx="3" fill="#b9c1cc"></rect>
    <rect x="470" y="280" width="180" height="10" rx="3" fill="#b9c1cc"></rect>
    <rect x="88" y="376" width="620" height="10" rx="3" fill="#cfd5dd"></rect>
    <!-- Ztmavení stránky pod lištou -->
    <rect x="62" y="84" width="676" height="432" fill="#0b1a33" opacity="0.28"></rect>

    <!-- Lišta s cookies -->
    <g filter="url(#cb-banner-shadow)">
      <rect x="62" y="318" width="676" height="198" fill="#ffffff"></rect>
    </g>
    <text x="90" y="356" font-size="22" font-weight="700" fill="#1b1f23">🍪 Vaše soukromí je pro nás důležité</text>
    <text x="90" y="388" font-size="16" fill="#3d4650">Tento web používá cookies ke zlepšení služeb a k zobrazování</text>
    <text x="90" y="410" font-size="16" fill="#3d4650">přizpůsobené reklamy. Souhlas můžete kdykoli změnit.</text>
    <!-- Tlačítka: nápadné „Přijmout vše“, méně nápadné ostatní -->
    <rect x="90" y="436" width="210" height="52" rx="8" fill="#1d4f91"></rect>
    <text x="195" y="469" font-size="19" font-weight="700" text-anchor="middle" fill="#ffffff">Přijmout vše</text>
    <rect x="318" y="436" width="200" height="52" rx="8" fill="#ffffff" stroke="#8a93a1" stroke-width="2"></rect>
    <text x="418" y="469" font-size="19" text-anchor="middle" fill="#3d4650">Odmítnout vše</text>
    <text x="580" y="469" font-size="18" fill="#1d4f91" text-decoration="underline">Nastavení</text>
    <rect x="62" y="44" width="676" height="472" fill="url(#cb-glare)"></rect>
  </g>

  <!-- Upozornění na méně nápadné tlačítko -->
  <rect x="306" y="424" width="224" height="76" rx="14" fill="none" stroke="#e3a33b" stroke-width="5" stroke-dasharray="10 7"></rect>
</svg>
