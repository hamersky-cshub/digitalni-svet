---
/** „Zastávka 2 z 5 · Co sdílím“ a „Krok 1 ze 3“ – bez procent a skóre. */
import { workshopHref } from '../lib/url';
import { zOrZe } from '../lib/text';
import Icon from './Icon.astro';

interface Props {
  workshopId: string;
  workshopTitle: string;
  stopTitle: string;
  stopNumber: number;
  stopCount: number;
  stepNumber: number;
  stepCount: number;
  /** Cíl zastávky (jen na prvním kroku). */
  goal?: string;
}

const { workshopId, workshopTitle, stopTitle, stopNumber, stopCount, stepNumber, stepCount, goal } = Astro.props;
const stopDots = Array.from({ length: stopCount }, (_, i) => i + 1);
---

<nav class="progress" aria-label="Kde se nacházíte">
  <p class="progress__workshop">
    <a href={workshopHref(workshopId)}>{workshopTitle}</a>
  </p>
  <p class="progress__stop">
    <span class="progress__stop-number">Zastávka {stopNumber} {zOrZe(stopCount)} {stopCount}</span>
    <span aria-hidden="true"> · </span>
    <span class="progress__stop-title">{stopTitle}</span>
  </p>
  <ol class="progress__route" aria-hidden="true">
    {
      stopDots.map((n) => (
        <li class:list={['progress__dot', { 'is-done': n < stopNumber, 'is-current': n === stopNumber }]}>{n}</li>
      ))
    }
  </ol>
  {stepCount > 1 && <p class="progress__step">Krok {stepNumber} {zOrZe(stepCount)} {stepCount}</p>}
  {
    goal && (
      <p class="progress__goal">
        <Icon name="target" />
        <span>
          <strong>Cíl zastávky:</strong> {goal}
        </span>
      </p>
    )
  }
</nav>

<style>
  .progress {
    margin: var(--space-3) 0 var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--color-surface-alt);
  }

  .progress p {
    margin: 0;
    max-width: none;
  }

  .progress__workshop {
    font-size: 0.9rem;
  }

  .progress__workshop a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .progress__stop {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .progress__route {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    column-gap: 0;
    align-items: center;
    margin: var(--space-1) 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .progress__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin: 0 0.9rem 0 0;
    border: 2px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .progress__dot + .progress__dot {
    margin-top: 0;
  }

  .progress__dot:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 100%;
    width: 0.9rem;
    height: 2px;
    background: var(--color-border);
  }

  .progress__dot.is-done {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .progress__dot.is-current {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: 0 0 0 3px var(--color-accent);
  }

  .progress__step {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .progress__goal {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: var(--space-1) !important;
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--module-soft, var(--color-accent-soft));
  }

  .progress__goal :global(.icon) {
    margin-top: 0.15em;
    color: var(--module-text, var(--color-primary));
  }

  @media (max-width: 40rem) {
    .progress__dot {
      width: 1.65rem;
      height: 1.65rem;
      margin-right: 0.35rem;
      font-size: 0.75rem;
    }

    .progress__dot:last-child {
      margin-right: 0;
    }

    .progress__dot:not(:last-child)::after {
      display: none;
    }
  }
</style>
