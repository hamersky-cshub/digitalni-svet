  <circle cx="32" cy="32" r="22" fill="none" stroke="#2563eb" stroke-width="1.5" stroke-dasharray="2 4"></circle>
  <polygon points="32,9 38.5,32 32,55 25.5,32" fill="#2563eb"></polygon>
  <polygon points="32,9 38.5,32 25.5,32" fill="#2563eb"></polygon>
