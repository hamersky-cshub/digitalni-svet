---
import { RESOURCE_TYPES } from '../content.config';
import { TYPE_LABELS } from '../lib/resources';

interface Props {
  /** id seznamu (<ul>), jehož položky se filtrují. */
  listId: string;
  /** Témata k výběru; když chybí, filtr podle tématu se nezobrazí. */
  topics?: { id: string; title: string }[];
  /** Typy, které se v seznamu skutečně vyskytují. */
  types?: readonly (typeof RESOURCE_TYPES)[number][];
}

const { listId, topics, types = RESOURCE_TYPES } = Astro.props;
---

<!-- Filtr se zobrazí až po načtení skriptu; bez JavaScriptu jsou vidět všechny materiály. -->
<resource-filter data-list={listId} hidden>
  <form class="filter" aria-label="Filtrovat materiály">
    {
      topics && (
        <div class="filter__field">
          <label for={`${listId}-topic`}>Téma</label>
          <select id={`${listId}-topic`} name="topic">
            <option value="">Všechna témata</option>
            {topics.map((t) => (
              <option value={t.id}>{t.title}</option>
            ))}
          </select>
        </div>
      )
    }
    <div class="filter__field">
      <label for={`${listId}-type`}>Druh materiálu</label>
      <select id={`${listId}-type`} name="type">
        <option value="">Všechny druhy</option>
        {types.map((t) => <option value={t}>{TYPE_LABELS[t]}</option>)}
      </select>
    </div>
    <div class="filter__field filter__reset">
      <button type="reset" class="button button--secondary">Zobrazit vše</button>
    </div>
  </form>
  <p class="filter__status" role="status" aria-live="polite"></p>
</resource-filter>

<script>
  function pluralize(n: number): string {
    if (n === 1) return 'Zobrazen 1 materiál';
    if (n >= 2 && n <= 4) return `Zobrazeny ${n} materiály`;
    return `Zobrazeno ${n} materiálů`;
  }

  class ResourceFilter extends HTMLElement {
    connectedCallback() {
      const list = document.getElementById(this.dataset.list ?? '');
      const form = this.querySelector('form');
      const status = this.querySelector<HTMLElement>('.filter__status');
      if (!list || !form || !status) return;

      const items = Array.from(list.querySelectorAll<HTMLElement>(':scope > [data-type]'));
      const empty = document.getElementById(`${list.id}-empty`);

      const apply = () => {
        const data = new FormData(form);
        const topic = String(data.get('topic') ?? '');
        const type = String(data.get('type') ?? '');
        let visible = 0;
        for (const item of items) {
          const match = (!topic || item.dataset.topic === topic) && (!type || item.dataset.type === type);
          item.hidden = !match;
          if (match) visible++;
        }
        status.textContent = `${pluralize(visible)} z ${items.length}.`;
        if (empty) empty.hidden = visible > 0;
      };

      form.addEventListener('submit', (event) => event.preventDefault());
      form.addEventListener('change', apply);
      // Po „Zobrazit vše“ se hodnoty formuláře vynulují až po události reset.
      form.addEventListener('reset', () => setTimeout(apply));

      this.hidden = false;
      apply();
    }
  }

  customElements.define('resource-filter', ResourceFilter);
</script>

<style>
  resource-filter {
    display: block;
    margin: var(--space-3) 0;
    padding: var(--space-3);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  resource-filter[hidden] {
    display: none;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-2) var(--space-3);
  }

  .filter__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 14rem;
  }

  .filter__reset {
    flex: 0 0 auto;
  }

  label {
    font-weight: 700;
  }

  select {
    min-height: var(--tap-size);
    padding: 0.4rem 0.75rem;
    border: 3px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .filter__status {
    margin: var(--space-2) 0 0;
    font-weight: 600;
  }
</style>
