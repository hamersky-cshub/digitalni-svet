---
/** Štítek „co se teď děje“ – pomáhá účastníkovi zorientovat se. */
import type { ScreenKind } from '../content.config';
import { SCREEN_KIND_INFO } from '../lib/presentation';

interface Props {
  kind: ScreenKind;
}

const { kind } = Astro.props;
const KINDS = SCREEN_KIND_INFO;
---

<p class="screen-kind">
  <span aria-hidden="true">{KINDS[kind].icon}</span>
  {KINDS[kind].label}
</p>

<style>
  .screen-kind {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: var(--space-2) 0 0;
    padding: 0.2rem 0.9rem;
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 700;
  }
</style>
