---
import type { CollectionEntry } from 'astro:content';
import ActionButton from './ActionButton.astro';
import { TYPE_ICONS, TYPE_LABELS, detailHref, resourceAction } from '../lib/resources';

interface Props {
  resource: CollectionEntry<'resources'>;
  headingLevel?: 'h2' | 'h3';
}

const { resource, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, type, source } = resource.data;
const action = resourceAction(resource);
---

<li class="resource-card">
  <p class="resource-card__meta">
    <span class="badge">
      <span aria-hidden="true">{TYPE_ICONS[type]}</span>
      {TYPE_LABELS[type]}
    </span>
  </p>
  <Heading class="resource-card__title">
    <a href={detailHref(resource)}>{title}</a>
  </Heading>
  <p>{description}</p>
  {source && <p class="resource-card__source">Zdroj: {source}</p>}
  <p class="resource-card__action">
    <ActionButton action={action} variant="secondary" />
  </p>
</li>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .resource-card p {
    margin-bottom: var(--space-1);
  }

  .resource-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-size: 0.9rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-border-light);
    border-radius: 999px;
    background: var(--color-surface);
    font-weight: 600;
  }

  .resource-card__source {
    color: var(--color-text-muted);
  }

  .resource-card__title {
    margin: var(--space-1) 0;
    font-size: 1.25rem;
  }

  .resource-card__action {
    margin-top: auto;
    padding-top: var(--space-1);
  }
</style>
